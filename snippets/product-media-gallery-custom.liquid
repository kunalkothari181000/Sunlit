<section class="pr-imgs-slider">
  
  <!-- Main Slider -->
  <div class="swiper pr-imgs-swiper">
    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <div class="pr-img">
            
            {% if block.settings.image %}
              <img 
                src="{{ block.settings.image | image_url: width: 800 }}" 
                alt="{{ block.settings.alt | escape }}"
              >
            {% endif %}

          </div>
        </div>
      {% endfor %}

    </div>
  </div>

  <!-- Thumbnails -->
  <div class="pr-imgs-thumb">
    <div class="swiper pr-imgs-thumb-swiper">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="pr-img-thumb">
              
              {% if block.settings.image %}
                <img 
                  src="{{ block.settings.image | image_url: width: 200 }}" 
                  alt="{{ block.settings.alt | escape }}"
                >
              {% endif %}

            </div>
          </div>
        {% endfor %}

      </div>
    </div>
  </div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    var sectionEl = document.querySelector("#shopify-section-{{ section.id }}");

    var prImgsSwiper = new Swiper(sectionEl.querySelector(".pr-imgs-swiper"), {
      loop: false,
      slidesPerView: 1,
      spaceBetween: 0,
    });

    var prImgsThumbSwiper = new Swiper(sectionEl.querySelector(".pr-imgs-thumb-swiper"), {
      loop: false,
      slidesPerView: 3,
      spaceBetween: 10,
      watchSlidesProgress: true,
      breakpoints: {
        0: {
          slidesPerView: 3,
          spaceBetween: 5,
        },
        640: {
          slidesPerView: 4,
          spaceBetween: 7,
        },
        720: {
          slidesPerView: 5,
          spaceBetween: 10,
        },
      },
    });

    prImgsSwiper.params.thumbs = {
      swiper: prImgsThumbSwiper
    };
    prImgsSwiper.init();

  });
</script>

