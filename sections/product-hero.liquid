<header class="product-inner-header">

  {% if section.settings.bg_image %}
    <img 
      src="{{ section.settings.bg_image | image_url: width: 1920 }}" 
      alt="background"
    >
  {% endif %}

  <div class="container">
    <div class="row align-items-center">

      <!-- LEFT CONTENT -->
      <div class="col-lg-6 col-12">
        <div class="product-inner-content" data-aos="fade-right" data-aos-duration="1000">

          {% if section.settings.heading != blank %}
            <h1>{{ section.settings.heading }}</h1>
          {% endif %}

          {% if section.settings.description != blank %}
            <p class="para">
              {{ section.settings.description }}
            </p>
          {% endif %}

          <!-- STATIC VARIANT STYLE OPTIONS (editable text only) -->
          {% if section.blocks.size > 0 %}
            <ul class="varient-picker">
              {% for block in section.blocks %}
                <li {{ block.shopify_attributes }}>
                  <button>
                    <span>{{ block.settings.label }}</span>
                  </button>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          <!-- BUTTON -->
          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link }}" class="main-btn">
              <span>{{ section.settings.button_label }}</span>

              {% if section.settings.button_icon %}
                <img 
                  src="{{ section.settings.button_icon | image_url: width: 50 }}" 
                  alt="icon"
                >
              {% endif %}
            </a>
          {% endif %}

        </div>
      </div>

      <!-- RIGHT IMAGE -->
      <div class="col-lg-6 col-12">
        <div class="pr-hero" data-aos="fade-left" data-aos-duration="1000">

          {% if section.settings.product_image %}
            <img 
              src="{{ section.settings.product_image | image_url: width: 1000 }}" 
              class="w-100" 
              alt="product"
            >
          {% endif %}

        </div>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Product Hero",
  "tag": "section",
  "class": "product-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sunlit Farms Premium Atta"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Made from carefully selected, high-quality wheat and hygienically processed using modern milling technology to ensure purity, freshness, and consistent performance in every pack."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Right Side Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "Button Icon"
    }
  ],
  "blocks": [
    {
      "type": "variant",
      "name": "Variant Option",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Variant Label",
          "default": "1Kg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Hero",
      "category": "Custom",
      "blocks": [
        { "type": "variant", "settings": { "label": "1Kg" } },
        { "type": "variant", "settings": { "label": "2Kg" } },
        { "type": "variant", "settings": { "label": "5Kg" } },
        { "type": "variant", "settings": { "label": "10Kg" } }
      ]
    }
  ]
}
{% endschema %}