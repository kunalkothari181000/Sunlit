<section class="sec collection-sec">
  <div class="container">
    <div class="row justify-content-center">

      {% for block in section.blocks %}
        <div class="col-lg-4 col-12" {{ block.shopify_attributes }}>

          <a href="{{ block.settings.link }}" class="pr-card" data-aos="fade-up" data-aos-duration="1000">

            {% if block.settings.bg_image %}
              <img 
                src="{{ block.settings.bg_image | image_url: width: 600 }}" 
                alt="bg"
              >
            {% endif %}

            <div class="pr-img-2">
              {% if block.settings.image %}
                <img 
                  src="{{ block.settings.image | image_url: width: 500 }}" 
                  alt="{{ block.settings.title | escape }}"
                >
              {% endif %}
            </div>

            <div class="pr-con">
              <div class="tp">

                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title }}</h3>
                {% endif %}

                <!-- SVG PER CARD -->
                {% if block.settings.arrow_svg != blank %}
                  <span class="arrow-icon">
                    {{ block.settings.arrow_svg }}
                  </span>
                {% endif %}

              </div>

              {% if block.settings.text != blank %}
                <p class="para">
                  {{ block.settings.text }}
                </p>
              {% endif %}

            </div>

          </a>

        </div>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Cards",
  "tag": "section",
  "class": "collection-cards-section",
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Atta"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Scalable, compliant supply chains built for international trade and market standards."
        },
        {
          "type": "html",
          "id": "arrow_svg",
          "label": "Arrow SVG (per card)",
          "default": "<svg xmlns='http://www.w3.org/2000/svg' width='46' height='46' fill='none' viewBox='0 0 46 46'><g clip-path='url(#a)'><path fill='#965134' d='M6.736 6.737c-8.967 8.967-8.967 23.559 0 32.526 8.968 8.968 23.56 8.968 32.527 0 8.968-8.967 8.968-23.559 0-32.526-8.967-8.968-23.56-8.968-32.527 0ZM37.23 37.23c-7.846 7.846-20.614 7.846-28.46 0-7.848-7.847-7.848-20.615 0-28.462 7.846-7.846 20.614-7.846 28.46 0 7.847 7.847 7.847 20.615 0 28.461ZM29.1 15.463a1.437 1.437 0 0 1 1.437 1.437v10.165a1.433 1.433 0 0 1-1.437 1.437 1.435 1.435 0 0 1-1.438-1.437V20.37l-9.744 9.744a1.437 1.437 0 1 1-2.033-2.033l9.744-9.744h-6.694a1.437 1.437 0 1 1 0-2.874H29.1Z'/></g><defs><clipPath id='a'><path fill='#fff' d='M0 0h46v46H0z'/></clipPath></defs></svg>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Cards",
      "category": "Custom",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}