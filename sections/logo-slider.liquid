<section class="lg-slider-sec">
  {% assign layout_type = section.settings.layout_type | default: 'grid' %}
  {% if section.settings.enable_marquee and section.settings.layout_type == blank %}
    {% assign layout_type = 'marquee' %}
  {% endif %}

  <div class="{% if layout_type == 'marquee' %}container-fluid px-0{% else %}container{% endif %}">
    
    {% if layout_type == 'grid' %}
      <div class="logo-grid-wrapper" data-aos="fade-up" data-aos-duration="1000">
        <div class="row row-cols-{{ section.settings.grid_columns_mobile | default: '2' }} row-cols-sm-3 row-cols-md-4 row-cols-lg-{{ section.settings.grid_columns_desktop | default: '6' }} g-3 g-md-4 justify-content-center align-items-center">
          {% for block in section.blocks %}
            <div class="col d-flex justify-content-center align-items-center" {{ block.shopify_attributes }}>
              <div class="lg-wrap lg-grid-card">
                {% if block.settings.logo %}
                  <img 
                    src="{{ block.settings.logo | image_url: width: 400 }}" 
                    alt="{{ block.settings.alt_text | escape }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="row g-0">
        <div class="col-12">
          <div class="swiper lg-swiper lg-swiper-{{ section.id }} {% if layout_type == 'marquee' %}is-marquee{% endif %}" 
               data-aos="fade-up" 
               data-aos-duration="1000"
               data-marquee="{% if layout_type == 'marquee' %}true{% else %}false{% endif %}"
               data-speed="{{ section.settings.marquee_speed }}"
               data-desktop="{{ section.settings.slides_desktop }}"
               data-mobile="{{ section.settings.slides_mobile }}"
               data-space="{{ section.settings.space_between }}">
            <div class="swiper-wrapper">

              {% for block in section.blocks %}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  <div class="lg-wrap">
                    {% if block.settings.logo %}
                      <img 
                        src="{{ block.settings.logo | image_url: width: 400 }}" 
                        alt="{{ block.settings.alt_text | escape }}"
                        loading="lazy"
                      >
                    {% endif %}
                  </div>
                </div>
              {% endfor %}

              {% comment %} Duplicate blocks for seamless infinite marquee loop {% endcomment %}
              {% if layout_type == 'marquee' %}
                {% for block in section.blocks %}
                  <div class="swiper-slide" aria-hidden="true">
                    <div class="lg-wrap">
                      {% if block.settings.logo %}
                        <img 
                          src="{{ block.settings.logo | image_url: width: 400 }}" 
                          alt="{{ block.settings.alt_text | escape }}"
                          loading="lazy"
                        >
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              {% endif %}

            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    function initLogoSwiper_{{ section.id | replace: '-', '_' }}() {
      var container = document.querySelector(".lg-swiper-{{ section.id }}");
      if (!container) return;

      if (container.swiper) {
        try {
          container.swiper.destroy(true, true);
        } catch (e) {}
      }

      var isMarquee = container.getAttribute("data-marquee") === "true";
      var speed = parseInt(container.getAttribute("data-speed")) || 4000;
      var desktopSlides = parseInt(container.getAttribute("data-desktop")) || 5;
      var mobileSlides = parseInt(container.getAttribute("data-mobile")) || 3;
      var space = parseInt(container.getAttribute("data-space")) || 15;

      if (isMarquee) {
        new Swiper(container, {
          loop: true,
          autoplay: {
            delay: 0,
            disableOnInteraction: false,
            pauseOnMouseEnter: false
          },
          speed: speed,
          slidesPerView: "auto",
          spaceBetween: space,
          freeMode: true,
          freeModeMomentum: false,
          allowTouchMove: false
        });
      } else {
        new Swiper(container, {
          loop: true,
          autoplay: {
            delay: 2500,
            disableOnInteraction: false
          },
          speed: 800,
          spaceBetween: space,
          slidesPerView: desktopSlides,
          breakpoints: {
            0: {
              slidesPerView: mobileSlides,
              spaceBetween: 15
            },
            768: {
              slidesPerView: Math.min(4, desktopSlides),
              spaceBetween: 20
            },
            1024: {
              slidesPerView: desktopSlides,
              spaceBetween: space
            }
          }
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLogoSwiper_{{ section.id | replace: '-', '_' }});
    } else {
      initLogoSwiper_{{ section.id | replace: '-', '_' }}();
    }

    document.addEventListener("shopify:section:load", function (e) {
      if (e.detail && e.detail.sectionId === "{{ section.id }}") {
        initLogoSwiper_{{ section.id | replace: '-', '_' }}();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Logo Section",
  "tag": "section",
  "class": "logo-slider-section",
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Style",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid Layout" },
        { "value": "marquee", "label": "Infinite Marquee Loop" },
        { "value": "slider", "label": "Standard Slider Carousel" }
      ]
    },
    {
      "type": "select",
      "id": "grid_columns_desktop",
      "label": "Grid Columns (Desktop)",
      "default": "6",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" },
        { "value": "5", "label": "5 Columns" },
        { "value": "6", "label": "6 Columns" }
      ]
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Grid Columns (Mobile)",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable Non-Stop Marquee Loop (Legacy)",
      "default": false
    },
    {
      "type": "select",
      "id": "marquee_speed",
      "label": "Marquee Speed",
      "default": "4000",
      "options": [
        { "value": "2000", "label": "Fast (2s)" },
        { "value": "4000", "label": "Medium (4s)" },
        { "value": "6000", "label": "Slow (6s)" },
        { "value": "8000", "label": "Very Slow (8s)" }
      ]
    },
    {
      "type": "select",
      "id": "slides_desktop",
      "label": "Slider Desktop Visible Logos",
      "default": "5",
      "options": [
        { "value": "3", "label": "3 Logos" },
        { "value": "4", "label": "4 Logos" },
        { "value": "5", "label": "5 Logos" },
        { "value": "6", "label": "6 Logos" },
        { "value": "8", "label": "8 Logos" }
      ]
    },
    {
      "type": "select",
      "id": "slides_mobile",
      "label": "Slider Mobile Visible Logos",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 Logo" },
        { "value": "2", "label": "2 Logos" },
        { "value": "3", "label": "3 Logos" }
      ]
    },
    {
      "type": "select",
      "id": "space_between",
      "label": "Space Between Logos",
      "default": "30",
      "options": [
        { "value": "15", "label": "Compact (15px)" },
        { "value": "30", "label": "Standard (30px)" },
        { "value": "45", "label": "Wide (45px)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Brand Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Section",
      "category": "Custom",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
