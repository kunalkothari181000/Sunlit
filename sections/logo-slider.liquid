<section class="lg-slider-sec">
  <div class="container-fluid px-0">
    <div class="row g-0">
      <div class="col-12">
        <div class="swiper lg-swiper" data-aos="fade-up" data-aos-duration="1000">
          <div class="swiper-wrapper">

            {% for block in section.blocks %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="lg-wrap">
                  
                  {% if block.settings.logo %}
                    <img 
                      src="{{ block.settings.logo | image_url: width: 300 }}" 
                      alt="{{ block.settings.alt_text | escape }}"
                      loading="lazy"
                    >
                  {% endif %}

                </div>
              </div>
            {% endfor %}

            {% comment %} Duplicate blocks for seamless infinite marquee loop {% endcomment %}
            {% for block in section.blocks %}
              <div class="swiper-slide" aria-hidden="true">
                <div class="lg-wrap">
                  
                  {% if block.settings.logo %}
                    <img 
                      src="{{ block.settings.logo | image_url: width: 300 }}" 
                      alt="{{ block.settings.alt_text | escape }}"
                      loading="lazy"
                    >
                  {% endif %}

                </div>
              </div>
            {% endfor %}

          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var lgswiper = new Swiper(".lg-swiper", {
      loop: true,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: false
      },
      speed: 4000,
      slidesPerView: "auto",
      spaceBetween: 40,
      freeMode: true,
      freeModeMomentum: false,
      allowTouchMove: false
    });
  });
</script>

{% schema %}
{
  "name": "Logo Slider",
  "tag": "section",
  "class": "logo-slider-section",
  "settings": [],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Brand Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Slider",
      "category": "Custom",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}