<style>
  .journey-sec {
    background: #f8fafc;
    padding: 6.5em 0 6em;
    position: relative;
    overflow: hidden;
  }
  .journey-header-wrap {
    margin-top: 1.5em;
    margin-bottom: 4em;
  }
  .timeline-wrapper {
    position: relative;
    max-width: 1050px;
    margin: 0 auto;
  }
  .timeline-line-center {
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    z-index: 1;
  }
  .timeline-svg-scroll {
    width: 100%;
    height: 100%;
  }

  .timeline-grid-flow {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
    z-index: 2;
  }
  
  /* Bulletproof 3-Column Grid: Left Card (1fr) | Center Node (60px) | Right Card (1fr) */
  .timeline-grid-row {
    display: grid !important;
    grid-template-columns: 1fr 60px 1fr !important;
    align-items: center !important;
    width: 100% !important;
  }

  .timeline-card {
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 22px !important;
    padding: 2em 2.2em !important;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04) !important;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease !important;
    position: relative !important;
  }
  .timeline-card:hover {
    transform: translateY(-5px) !important;
    border-color: #f97316 !important;
    box-shadow: 0 20px 50px rgba(249, 115, 22, 0.12) !important;
  }

  .tc-year-pill {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    padding: 6px 18px;
    border-radius: 100px;
    box-shadow: 0 6px 16px rgba(249, 115, 22, 0.22);
    margin-bottom: 12px;
  }

  .tc-title {
    font-size: 21px !important;
    font-weight: 800 !important;
    color: #184333 !important;
    margin-bottom: 8px !important;
    line-height: 1.25 !important;
  }
  .tc-text {
    font-size: 15px !important;
    color: #475569 !important;
    line-height: 1.6 !important;
    margin-bottom: 0 !important;
  }

  /* Center Node (Guaranteed Centered) */
  .timeline-center-node {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    width: 60px !important;
    height: 100% !important;
    margin: 0 auto !important;
  }
  .node-ring {
    width: 26px;
    height: 26px;
    background: #ffffff;
    border: 3px solid #f97316;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 5px rgba(249, 115, 22, 0.15);
    transition: all 0.35s ease;
  }
  .timeline-grid-row:hover .node-ring {
    transform: scale(1.25);
    border-color: #184333;
    box-shadow: 0 0 0 7px rgba(24, 67, 51, 0.2);
  }
  .node-dot {
    width: 8px;
    height: 8px;
    background: #f97316;
    border-radius: 50%;
  }

  /* 2025 Sunlit Logo Space */
  .tc-logo-badge {
    background: #fff8e7;
    border: 1.5px solid #ffb74d;
    padding: 10px 20px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 6px 18px rgba(245, 158, 11, 0.12);
  }
  .tc-logo-badge img {
    max-height: 40px;
    width: auto;
    object-fit: contain;
  }
  .tc-logo-tag {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #78350f;
    background: rgba(245, 158, 11, 0.2);
    padding: 4px 10px;
    border-radius: 100px;
  }

  @media (max-width: 991px) {
    .timeline-line-center {
      left: 20px;
    }
    .timeline-grid-row {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      padding-left: 45px !important;
      position: relative !important;
    }
    .timeline-center-node {
      position: absolute !important;
      left: -10px !important;
      top: 24px !important;
      width: 30px !important;
    }
    .timeline-card {
      width: 100% !important;
    }
    .timeline-card-space {
      display: none !important;
    }
  }
</style>

<section class="journey-sec sec">
  <div class="container">
    
    <!-- Section Header (Clean Spaced Stack) -->
    <div class="journey-header-wrap text-center">
      <div class="row">
        <div class="col-lg-8 col-12 mx-auto">
          <div class="d-block mb-2" data-aos="fade-down" data-aos-duration="800">
            <span class="sub-pill">Milestones & History</span>
          </div>
          <h2 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
            {{ section.settings.heading | default: "Our Journey" }}
          </h2>
          <p class="para mt-3" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
            {{ section.settings.subtext | default: "From a single milling operation to a trusted manufacturing partner serving leading food brands across India." }}
          </p>
        </div>
      </div>
    </div>

    <!-- Timeline Wrapper with SVG Scroll Line -->
    <div class="timeline-wrapper">
      
      <!-- Central Animated SVG Line -->
      <div class="timeline-line-center">
        <svg class="timeline-svg-scroll" viewBox="0 0 4 1000" preserveAspectRatio="none" fill="none">
          <line x1="2" y1="0" x2="2" y2="1000" stroke="#cbd5e1" stroke-width="4" stroke-dasharray="8 6"/>
          <line x1="2" y1="0" x2="2" y2="1000" stroke="url(#timelineGlow)" stroke-width="4"/>
          <defs>
            <linearGradient id="timelineGlow" x1="0" y1="0" x2="0" y2="1000" gradientUnits="userSpaceOnUse">
              <stop stop-color="#f97316"/>
              <stop offset="0.5" stop-color="#ffb74d"/>
              <stop offset="1" stop-color="#184333"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Timeline Items (Bulletproof CSS Grid Rows) -->
      <div class="timeline-grid-flow">
        {% for block in section.blocks %}
          {% assign is_even = forloop.index | modulo: 2 %}
          
          <div class="timeline-grid-row" data-aos="fade-up" data-aos-duration="800" {{ block.shopify_attributes }}>
            
            {% if is_even != 0 %}
              <!-- LEFT ROW: Card in Col 1 | Node in Col 2 | Empty in Col 3 -->
              <div class="timeline-card">
                <div class="tc-year-pill">
                  <span>{{ block.settings.year }}</span>
                </div>
                {% if block.settings.title != blank %}
                  <h3 class="tc-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="tc-text">{{ block.settings.text }}</p>
                {% endif %}
                {% if block.settings.year == '2025' or block.settings.logo != blank %}
                  <div class="tc-logo-badge mt-3">
                    {% if block.settings.logo %}
                      <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.title | escape }}">
                    {% else %}
                      <img src="https://cdn.shopify.com/s/files/1/0000/0000/files/logo.png" alt="Sunlit Farms Logo">
                    {% endif %}
                    <span class="tc-logo-tag">Brand Launch</span>
                  </div>
                {% endif %}
              </div>

              <div class="timeline-center-node">
                <div class="node-ring"><div class="node-dot"></div></div>
              </div>

              <div class="timeline-card-space"></div>

            {% else %}
              <!-- RIGHT ROW: Empty in Col 1 | Node in Col 2 | Card in Col 3 -->
              <div class="timeline-card-space"></div>

              <div class="timeline-center-node">
                <div class="node-ring"><div class="node-dot"></div></div>
              </div>

              <div class="timeline-card">
                <div class="tc-year-pill">
                  <span>{{ block.settings.year }}</span>
                </div>
                {% if block.settings.title != blank %}
                  <h3 class="tc-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="tc-text">{{ block.settings.text }}</p>
                {% endif %}
                {% if block.settings.year == '2025' or block.settings.logo != blank %}
                  <div class="tc-logo-badge mt-3">
                    {% if block.settings.logo %}
                      <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.title | escape }}">
                    {% else %}
                      <img src="https://cdn.shopify.com/s/files/1/0000/0000/files/logo.png" alt="Sunlit Farms Logo">
                    {% endif %}
                    <span class="tc-logo-tag">Brand Launch</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}

          </div>
        {% endfor %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Our Journey",
  "tag": "section",
  "class": "journey-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "From a single milling operation to a trusted manufacturing partner serving leading food brands across India."
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "1999"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Milestone Title",
          "default": "The Beginning"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Milestone Description",
          "default": "Started operations with Simran Foods and a capacity of 60 TPD."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Milestone Logo (e.g. for Sunlit Farms 2025 launch)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Journey",
      "category": "Custom",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "year": "1999",
            "title": "The Beginning",
            "text": "Started operations with Simran Foods and a capacity of 60 TPD."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2004",
            "title": "First Expansion",
            "text": "Scaled operations to 200 TPD to meet growing demand."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2008",
            "title": "Strategic Growth",
            "text": "Acquired Akshat Roller Mills, adding 150 TPD capacity."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2010",
            "title": "Scaling Up",
            "text": "Expanded production capacity to 650 MT."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2011",
            "title": "FMCG Partnerships",
            "text": "Began supplying leading brands including Parle, Britannia and ITC."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2014",
            "title": "New Facility",
            "text": "Launched Akshat Agro, Indore with 400 TPD capacity."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2015",
            "title": "Consumer Brand Launch",
            "text": "Introduced Healthy Season for retail consumers."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2025",
            "title": "A New Chapter",
            "text": "Launched Sunlit Farms across the staples category."
          }
        }
      ]
    }
  ]
}
{% endschema %}
