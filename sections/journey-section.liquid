<section class="journey-sec sec">
  <div class="container">
    
    <!-- Section Header (Centered Stack) -->
    <div class="row text-center mb-5">
      <div class="col-lg-8 col-12 mx-auto">
        <div class="d-block mb-2" data-aos="fade-down" data-aos-duration="800">
          <span class="sub-pill">Milestones & History</span>
        </div>
        <h2 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
          {{ section.settings.heading | default: "Our Journey" }}
        </h2>
        <p class="para mt-3" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          {{ section.settings.subtext | default: "From a single milling operation to a trusted manufacturing partner serving leading food brands across India." }}
        </p>
      </div>
    </div>

    <!-- Ashya-Style Connected Timeline Container -->
    <div class="ashya-timeline-container">

      <!-- Dynamic Diagonal Connecting SVG Path -->
      <svg class="ashya-connecting-svg" viewBox="0 0 100 1000" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M 50,20 Q 85,150 15,300 T 85,600 T 15,900 T 50,1000" stroke="#f97316" stroke-width="3" stroke-dasharray="6 6" class="ashya-svg-line"/>
      </svg>

      <div class="ashya-timeline-items">
        {% for block in section.blocks %}
          {% assign is_even = forloop.index | modulo: 2 %}
          
          <div class="ashya-item-row {% if is_even == 0 %}row-reverse-item{% endif %}" data-aos="fade-up" data-aos-duration="900" {{ block.shopify_attributes }}>
            
            <!-- Left Box (Visual Art / Image) -->
            <div class="ashya-visual-box">
              <div class="ashya-art-card">
                <div class="ashya-art-badge">{{ block.settings.year }}</div>
                <div class="ashya-art-illustration">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#184333" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <span class="ashya-milestone-tag">Milestone 0{{ forloop.index }}</span>
              </div>
            </div>

            <!-- Central Numbered Node Button -->
            <div class="ashya-node-col">
              <div class="ashya-num-node">
                <span>{{ forloop.index }}</span>
              </div>
            </div>

            <!-- Right Box (Text Content) -->
            <div class="ashya-text-box">
              <span class="ashya-eyebrow">{{ block.settings.year }} • MILESTONE</span>
              <h3 class="ashya-title">{{ block.settings.title }}</h3>
              <p class="ashya-desc">{{ block.settings.text }}</p>
            </div>

          </div>
        {% endfor %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Our Journey",
  "tag": "section",
  "class": "journey-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "From a single milling operation to a trusted manufacturing partner serving leading food brands across India."
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "1999"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Milestone Title",
          "default": "The Beginning"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Milestone Description",
          "default": "Started operations with Simran Foods and a capacity of 60 TPD."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Journey",
      "category": "Custom",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "year": "1999",
            "title": "The Beginning",
            "text": "Started operations with Simran Foods and a capacity of 60 TPD."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2004",
            "title": "First Expansion",
            "text": "Scaled operations to 200 TPD to meet growing demand."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2008",
            "title": "Strategic Growth",
            "text": "Acquired Akshat Roller Mills, adding 150 TPD capacity."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2010",
            "title": "Scaling Up",
            "text": "Expanded production capacity to 650 MT."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2011",
            "title": "FMCG Partnerships",
            "text": "Began supplying leading brands including Parle, Britannia and ITC."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2014",
            "title": "New Facility",
            "text": "Launched Akshat Agro, Indore with 400 TPD capacity."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2015",
            "title": "Consumer Brand Launch",
            "text": "Introduced Healthy Season for retail consumers."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2025",
            "title": "A New Chapter",
            "text": "Launched Sunlit Farms across the staples category."
          }
        }
      ]
    }
  ]
}
{% endschema %}
