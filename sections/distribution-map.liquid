<style>
  .map-sec {
    background: #ffffff;
    padding: 5.5em 0;
  }
  .dist-stat-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 1.5em !important;
    margin-top: 2em !important;
  }
  .dist-stat-card {
    background: #f8fafc !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 22px !important;
    padding: 2em 1.6em !important;
    text-align: center !important;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03) !important;
  }
  .dist-stat-card:hover {
    transform: translateY(-6px) !important;
    border-color: #f97316 !important;
    box-shadow: 0 18px 45px rgba(249, 115, 22, 0.12) !important;
  }
  .dist-stat-card .count {
    font-size: 42px !important;
    font-weight: 800 !important;
    color: #f97316 !important;
    margin-bottom: 6px !important;
    line-height: 1 !important;
    display: block !important;
  }
  .dist-stat-card h4 {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #184333 !important;
    margin-bottom: 0 !important;
  }
  .map-visual-wrap {
    position: relative !important;
    border-radius: 32px !important;
    overflow: hidden !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08) !important;
    border: 1px solid #e2e8f0 !important;
  }
  .map-img {
    width: 100% !important;
    height: 480px !important;
    object-fit: cover !important;
    display: block !important;
  }
  .map-floating-badge {
    position: absolute !important;
    bottom: 24px !important;
    left: 24px !important;
    background: rgba(24, 67, 51, 0.94) !important;
    color: #ffffff !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    padding: 10px 22px !important;
    border-radius: 100px !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    backdrop-filter: blur(8px) !important;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2) !important;
  }
  .mfb-dot {
    width: 10px !important;
    height: 10px !important;
    background: #ffb74d !important;
    border-radius: 50% !important;
    animation: pulseDot 1.5s infinite !important;
  }
  @keyframes pulseDot {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.6); opacity: 0.4; }
    100% { transform: scale(1); opacity: 1; }
  }
  @media (max-width: 767px) {
    .dist-stat-grid {
      grid-template-columns: repeat(1, 1fr) !important;
    }
  }
</style>

<section class="map-sec sec">
  <div class="container">
    <div class="row align-items-center g-5">

      <!-- LEFT CONTENT & 2x2 STATS GRID -->
      <div class="col-lg-6 col-12" data-aos="fade-right" data-aos-duration="1000">
        
        <span class="sub-pill mb-2">Pan-India Footprint</span>

        {% if section.settings.heading != blank %}
          <h2 class="sec-head d-inline-block with-gr">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="para my-3">
            {{ section.settings.text }}
          </p>
        {% endif %}

        <!-- 2x2 Stat Cards Grid -->
        <div class="dist-stat-grid">
          {% for block in section.blocks %}
            <div class="dist-stat-card" {{ block.shopify_attributes }}>
              <span class="count">{{ block.settings.value }}+</span>
              <h4>{{ block.settings.title }}</h4>
            </div>
          {% endfor %}
        </div>

      </div>

      <!-- RIGHT MAP VISUAL -->
      <div class="col-lg-6 col-12" data-aos="fade-left" data-aos-duration="1000">
        <div class="map-visual-wrap">
          {% if section.settings.image %}
            <img 
              src="{{ section.settings.image | image_url: width: 1000 }}" 
              class="map-img" 
              alt="Distribution Network Map"
            >
          {% else %}
            <img 
              src="https://cdn.shopify.com/s/files/1/0000/0000/files/map.png" 
              class="map-img" 
              alt="Distribution Network Map"
            >
          {% endif %}

          <div class="map-floating-badge">
            <span class="mfb-dot"></span>
            <span>Expanding Pan-India Distribution</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Distribution Map",
  "tag": "section",
  "class": "distribution-map-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Growing Across Markets"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "From regional roots to a growing footprint across India and international markets, Sunlit Farms continues to expand through strong partnerships and dependable supply."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Map Image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value Number",
          "default": "16"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Stat Title",
          "default": "States Served"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Distribution Map",
      "category": "Custom",
      "blocks": [
        { "type": "stat", "settings": { "value": "16", "title": "States Served" } },
        { "type": "stat", "settings": { "value": "85", "title": "Retail Presence" } },
        { "type": "stat", "settings": { "value": "100", "title": "Wholesale Partners" } },
        { "type": "stat", "settings": { "value": "549", "title": "Retail Outlets" } }
      ]
    }
  ]
}
{% endschema %}