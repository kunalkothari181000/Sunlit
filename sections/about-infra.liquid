<style>
  .about-infra-sec {
    padding: 4.5em 0;
    background: #ffffff;
  }
  .infra-banner-box {
    background: linear-gradient(135deg, #184333 0%, #0a241a 100%) !important;
    border-radius: 32px !important;
    padding: 4em 3em !important;
    box-shadow: 0 25px 65px rgba(24, 67, 51, 0.3) !important;
    position: relative !important;
    overflow: hidden !important;
  }
  .infra-banner-box::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -30%;
    width: 150%;
    height: 150%;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .infra-premium-card {
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    backdrop-filter: blur(12px) !important;
    border-radius: 24px !important;
    padding: 2.2em 1.8em !important;
    height: 100% !important;
    transition: transform 0.35s ease, border-color 0.35s ease, background-color 0.35s ease !important;
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
  }
  .infra-premium-card:hover {
    transform: translateY(-6px) !important;
    border-color: #ffb74d !important;
    background: rgba(255, 255, 255, 0.14) !important;
  }
  .ipc-top {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    margin-bottom: 18px !important;
  }
  .ipc-num {
    font-size: 14px !important;
    font-weight: 800 !important;
    color: #ffb74d !important;
    background: rgba(255, 183, 77, 0.18) !important;
    padding: 4px 14px !important;
    border-radius: 100px !important;
  }
  .ipc-icon {
    width: 44px !important;
    height: 44px !important;
    background: rgba(249, 115, 22, 0.22) !important;
    color: #f97316 !important;
    border-radius: 12px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .ipc-title {
    font-size: 22px !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    line-height: 1.3 !important;
    margin-bottom: 10px !important;
  }
  .ipc-text {
    font-size: 14px !important;
    color: rgba(255, 255, 255, 0.85) !important;
    line-height: 1.5 !important;
    margin-bottom: 20px !important;
  }
  .ipc-bar {
    margin-top: auto !important;
    height: 3px !important;
    width: 40px !important;
    background: linear-gradient(90deg, #f97316, #ffb74d) !important;
    border-radius: 10px !important;
    transition: width 0.35s ease !important;
  }
  .infra-premium-card:hover .ipc-bar {
    width: 100% !important;
  }
</style>

<section class="about-infra-sec sec">
  <div class="container">

    <div class="infra-banner-box" data-aos="fade-up" data-aos-duration="1000">
      
      <!-- Top Header -->
      <div class="row mb-5 align-items-end">
        <div class="col-lg-7 col-12">
          <span class="hero-tag-badge mb-3">Industrial Power</span>
          {% if section.settings.heading != blank %}
            <h2 class="sec-head text-white d-inline-block mb-0">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>
        <div class="col-lg-5 col-12 mt-3 mt-lg-0">
          {% if section.settings.subtext != blank %}
            <p class="para text-white-50 mb-0">
              {{ section.settings.subtext }}
            </p>
          {% endif %}
        </div>
      </div>

      <!-- Feature Cards Grid -->
      <div class="row g-4">
        {% for block in section.blocks %}
          <div class="col-lg-4 col-md-6 col-12" {{ block.shopify_attributes }}>
            <div class="infra-premium-card" data-aos="fade-up" data-aos-duration="900" data-aos-delay="{{ forloop.index0 | times: 150 }}">
              
              <div class="ipc-top">
                <span class="ipc-num">0{{ forloop.index }}</span>
                <div class="ipc-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
              </div>

              {% if block.settings.title != blank %}
                <h3 class="ipc-title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="ipc-text">
                  {{ block.settings.text }}
                </p>
              {% endif %}

              <div class="ipc-bar"></div>

            </div>
          </div>
        {% endfor %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "About Infrastructure",
  "tag": "section",
  "class": "about-infra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Infrastructure Built for Scale"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "From sourcing and milling to packaging and dispatch, our infrastructure is designed to support high-volume production without compromising on consistency."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Infra Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1200 MT Daily Capacity"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Built to meet demand at scale with automated Bühler technology."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Infrastructure",
      "category": "Custom",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}