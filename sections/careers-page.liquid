<section class="careers-sec sec">
  <div class="container">
    
    <!-- Hero Title -->
    <div class="row text-center mb-5">
      <div class="col-lg-8 col-12 mx-auto">
        <h1 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
          {{ section.settings.heading | default: "Build Your Career at Sunlit Farms" }}
        </h1>
        <p class="para mt-3" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          {{ section.settings.subtext | default: "Join a fast-growing agri-food company committed to innovation, quality excellence, and empowering everyday meals for millions." }}
        </p>
      </div>
    </div>

    <!-- Why Join Us Grid -->
    <div class="row g-4 mb-5">
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000">
        <div class="career-benefit-card">
          <div class="b-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Rapid Growth</h3>
          <p class="para">Accelerate your career within a expanding FMCG & milling leader.</p>
        </div>
      </div>

      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
        <div class="career-benefit-card">
          <div class="b-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Safety & Culture</h3>
          <p class="para">Work in modern, automated, zero-contamination industrial facilities.</p>
        </div>
      </div>

      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
        <div class="career-benefit-card">
          <div class="b-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Collaborative Team</h3>
          <p class="para">Collaborate with experienced food technologists and engineers.</p>
        </div>
      </div>

      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
        <div class="career-benefit-card">
          <div class="b-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 6v12"/></svg>
          </div>
          <h3>Fair Compensation</h3>
          <p class="para">Enjoy competitive salaries, performance incentives, and health benefits.</p>
        </div>
      </div>
    </div>

    <!-- Current Openings -->
    <div class="row text-center mb-4">
      <div class="col-12">
        <h2 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
          Explore Current Openings
        </h2>
      </div>
    </div>

    <div class="row g-4 mb-5">
      
      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000">
        <div class="job-card">
          <div class="job-header">
            <div>
              <span class="j-type">Full-Time • Manufacturing</span>
              <h3>Plant Operations Manager</h3>
            </div>
            <span class="j-loc">Nimrani, MP</span>
          </div>
          <p class="para my-3">Lead daily flour milling operations, oversee Bühler system maintenance, and ensure production output targets with zero defect rates.</p>
          <div class="job-footer">
            <span class="j-exp">Experience: 5+ Years</span>
            <a href="#apply_form" class="main-btn border-btn sm-btn">Apply Now</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
        <div class="job-card">
          <div class="job-header">
            <div>
              <span class="j-type">Full-Time • Quality Assurance</span>
              <h3>Food Safety & QC Chemist</h3>
            </div>
            <span class="j-loc">Varanasi, UP</span>
          </div>
          <p class="para my-3">Conduct moisture analysis, ash content testing, gluten benchmarking, and maintain FSSAI / ISO quality records across batches.</p>
          <div class="job-footer">
            <span class="j-exp">Experience: 2+ Years</span>
            <a href="#apply_form" class="main-btn border-btn sm-btn">Apply Now</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
        <div class="job-card">
          <div class="job-header">
            <div>
              <span class="j-type">Full-Time • Sales & Distribution</span>
              <h3>Regional FMCG Sales Manager</h3>
            </div>
            <span class="j-loc">Chandauli, UP</span>
          </div>
          <p class="para my-3">Drive retail distributor expansion, manage wholesale accounts, and execute market penetration strategies for Sunlit products.</p>
          <div class="job-footer">
            <span class="j-exp">Experience: 4+ Years</span>
            <a href="#apply_form" class="main-btn border-btn sm-btn">Apply Now</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
        <div class="job-card">
          <div class="job-header">
            <div>
              <span class="j-type">Full-Time • Supply Chain</span>
              <h3>Logistics & Warehouse Officer</h3>
            </div>
            <span class="j-loc">Nimrani, MP</span>
          </div>
          <p class="para my-3">Coordinate fleet dispatch, manage grain silo inventory, and optimize supply routes across state borders.</p>
          <div class="job-footer">
            <span class="j-exp">Experience: 3+ Years</span>
            <a href="#apply_form" class="main-btn border-btn sm-btn">Apply Now</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Resume Submission Form -->
    <div class="row" id="apply_form" data-aos="fade-up" data-aos-duration="1000">
      <div class="col-lg-8 col-12 mx-auto">
        <div class="contact-form-wrap">
          <h2 class="form-head text-center mb-2">Apply for a Position</h2>
          <p class="para text-center mb-4">Don't see a relevant role? Submit your details and resume below for future openings.</p>

          <form method="post" action="/contact#apply_form" accept-charset="UTF-8" class="c-form">
            <input type="hidden" name="form_type" value="contact">
            <input type="hidden" name="utf8" value="✓">

            <div class="row">
              <div class="col-md-6 col-12 mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" name="contact[name]" class="form-control" placeholder="John Doe" required>
              </div>
              <div class="col-md-6 col-12 mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="contact[email]" class="form-control" placeholder="john@example.com" required>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 col-12 mb-3">
                <label class="form-label">Phone Number</label>
                <input type="tel" name="contact[phone]" class="form-control" placeholder="+91 9876543210" required>
              </div>
              <div class="col-md-6 col-12 mb-3">
                <label class="form-label">Desired Position</label>
                <select name="contact[position]" class="form-select">
                  <option value="Plant Operations Manager">Plant Operations Manager</option>
                  <option value="Food Safety & QC Chemist">Food Safety & QC Chemist</option>
                  <option value="Regional FMCG Sales Manager">Regional FMCG Sales Manager</option>
                  <option value="Logistics & Warehouse Officer">Logistics & Warehouse Officer</option>
                  <option value="General Application">General Application</option>
                </select>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Resume / LinkedIn Profile Link</label>
              <input type="url" name="contact[resume_link]" class="form-control" placeholder="https://linkedin.com/in/yourprofile or Google Drive link" required>
            </div>

            <div class="mb-4">
              <label class="form-label">Brief Introduction & Cover Note</label>
              <textarea name="contact[body]" class="form-control" rows="4" placeholder="Tell us about your experience and why you'd like to join Sunlit Farms..." required></textarea>
            </div>

            <button type="submit" class="main-btn orange-btn w-100">
              <span>Submit Application</span>
            </button>
          </form>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Careers Page",
  "tag": "section",
  "class": "careers-page-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Career at Sunlit Farms"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Join a fast-growing agri-food company committed to innovation, quality excellence, and empowering everyday meals for millions."
    }
  ],
  "presets": [
    {
      "name": "Careers Page"
    }
  ]
}
{% endschema %}
