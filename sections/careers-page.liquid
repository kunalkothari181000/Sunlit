<div class="page-hero-banner">
  <div class="container">
    <div class="row text-center">
      <div class="col-lg-8 col-12 mx-auto">
        <span class="hero-tag-badge" data-aos="fade-down" data-aos-duration="1000">Careers at Sunlit Farms</span>
        <h1 class="hero-page-head text-white" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          Shape the Future of Agri-Food
        </h1>
        <p class="hero-page-subtext text-white-50" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
          Join our team in bringing pure, hygienically milled staple foods to millions of homes across India.
        </p>
      </div>
    </div>
  </div>
</div>

<section class="careers-sec sec">
  <div class="container">

    <!-- Culture & Pillars -->
    <div class="row g-4 mb-5">
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800">
        <div class="culture-pillar-card">
          <div class="cp-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Rapid Scale</h3>
          <p class="para">Accelerate your career within a expanding FMCG & milling leader.</p>
        </div>
      </div>

      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="100">
        <div class="culture-pillar-card">
          <div class="cp-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Safety First</h3>
          <p class="para">Work in automated, zero-contamination Swiss milling environments.</p>
        </div>
      </div>

      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
        <div class="culture-pillar-card">
          <div class="cp-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Expert Teams</h3>
          <p class="para">Collaborate with experienced food technologists and engineers.</p>
        </div>
      </div>

      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="300">
        <div class="culture-pillar-card">
          <div class="cp-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 6v12"/></svg>
          </div>
          <h3>Great Benefits</h3>
          <p class="para">Competitive compensation, health incentives, and performance rewards.</p>
        </div>
      </div>
    </div>

    <!-- Section Heading -->
    <div class="row text-center mb-5">
      <div class="col-12">
        <span class="sub-pill">Join Us</span>
        <h2 class="sec-head with-gr d-inline-block">Open Roles</h2>
      </div>
    </div>

    <!-- Job Cards -->
    <div class="row g-4 mb-5">
      
      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000">
        <div class="job-card-modern">
          <div class="jm-head">
            <div>
              <span class="jm-cat">Manufacturing</span>
              <h3>Plant Operations Manager</h3>
            </div>
            <span class="jm-loc">Nimrani, MP</span>
          </div>
          <p class="para my-3">Lead daily flour milling operations, oversee Bühler automated systems, and enforce zero-defect quality targets.</p>
          <div class="jm-foot">
            <span class="jm-exp">5+ Years Exp.</span>
            <a href="#apply_section" class="main-btn orange-btn sm-btn">Apply Position</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
        <div class="job-card-modern">
          <div class="jm-head">
            <div>
              <span class="jm-cat">Quality Assurance</span>
              <h3>Food Safety & QC Chemist</h3>
            </div>
            <span class="jm-loc">Varanasi, UP</span>
          </div>
          <p class="para my-3">Conduct moisture analysis, ash content testing, gluten benchmarking, and maintain FSSAI / ISO records.</p>
          <div class="jm-foot">
            <span class="jm-exp">2+ Years Exp.</span>
            <a href="#apply_section" class="main-btn orange-btn sm-btn">Apply Position</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
        <div class="job-card-modern">
          <div class="jm-head">
            <div>
              <span class="jm-cat">Sales & Distribution</span>
              <h3>Regional FMCG Sales Manager</h3>
            </div>
            <span class="jm-loc">Chandauli, UP</span>
          </div>
          <p class="para my-3">Drive retail distributor expansion, manage wholesale accounts, and execute market penetration across territories.</p>
          <div class="jm-foot">
            <span class="jm-exp">4+ Years Exp.</span>
            <a href="#apply_section" class="main-btn orange-btn sm-btn">Apply Position</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
        <div class="job-card-modern">
          <div class="jm-head">
            <div>
              <span class="jm-cat">Supply Chain</span>
              <h3>Logistics & Grain Officer</h3>
            </div>
            <span class="jm-loc">Nimrani, MP</span>
          </div>
          <p class="para my-3">Coordinate fleet dispatch, manage grain silo inventory, and optimize supply routes across state lines.</p>
          <div class="jm-foot">
            <span class="jm-exp">3+ Years Exp.</span>
            <a href="#apply_section" class="main-btn orange-btn sm-btn">Apply Position</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Glass Application Form -->
    <div class="row" id="apply_section" data-aos="fade-up" data-aos-duration="1000">
      <div class="col-lg-8 col-12 mx-auto">
        <div class="contact-glass-form-box">
          <h2 class="c-box-title text-center mb-2">Apply for a Position</h2>
          <p class="para text-center mb-4">Don't see your specific role listed? Submit your resume for future opportunities.</p>

          <form method="post" action="/contact#apply_section" accept-charset="UTF-8" class="glass-form-grid">
            <input type="hidden" name="form_type" value="contact">
            <input type="hidden" name="utf8" value="✓">

            <div class="row">
              <div class="col-md-6 col-12 mb-3">
                <div class="form-floating">
                  <input type="text" name="contact[name]" class="form-control" id="k_name" placeholder="Full Name" required>
                  <label for="k_name">Full Name</label>
                </div>
              </div>
              <div class="col-md-6 col-12 mb-3">
                <div class="form-floating">
                  <input type="email" name="contact[email]" class="form-control" id="k_email" placeholder="Email Address" required>
                  <label for="k_email">Email Address</label>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 col-12 mb-3">
                <div class="form-floating">
                  <input type="tel" name="contact[phone]" class="form-control" id="k_phone" placeholder="Phone Number" required>
                  <label for="k_phone">Phone Number</label>
                </div>
              </div>
              <div class="col-md-6 col-12 mb-3">
                <div class="form-floating">
                  <select name="contact[position]" class="form-select" id="k_role">
                    <option value="Plant Operations Manager">Plant Operations Manager</option>
                    <option value="Food Safety & QC Chemist">Food Safety & QC Chemist</option>
                    <option value="Regional FMCG Sales Manager">Regional FMCG Sales Manager</option>
                    <option value="Logistics & Grain Officer">Logistics & Grain Officer</option>
                    <option value="General Career Inquiry">General Career Inquiry</option>
                  </select>
                  <label for="k_role">Target Role</label>
                </div>
              </div>
            </div>

            <div class="form-floating mb-3">
              <input type="url" name="contact[resume_link]" class="form-control" id="k_link" placeholder="Resume / LinkedIn URL" required>
              <label for="k_link">Resume Link / LinkedIn Profile URL</label>
            </div>

            <div class="form-floating mb-4">
              <textarea name="contact[body]" class="form-control" id="k_note" placeholder="Cover Note" style="height: 110px" required></textarea>
              <label for="k_note">Brief Cover Note / Bio</label>
            </div>

            <button type="submit" class="main-btn orange-btn w-100 py-3 fs-6">
              <span>Submit Application</span>
            </button>
          </form>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Careers Page",
  "tag": "section",
  "class": "careers-page-section",
  "settings": [],
  "presets": [
    {
      "name": "Careers Page"
    }
  ]
}
{% endschema %}
