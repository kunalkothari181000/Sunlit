<style>
  .policy-hero-banner {
    min-height: 50vh !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: linear-gradient(135deg, rgba(24, 67, 51, 0.92) 0%, rgba(10, 36, 26, 0.96) 100%), url('https://cdn.shopify.com/s/files/1/0000/0000/files/hero.png') center/cover no-repeat;
    padding-top: 140px !important;
    padding-bottom: 60px !important;
  }
  .policy-body-sec {
    background: #f8fafc;
    padding: 5em 0;
  }
  .policy-nav-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 1.8em 1.5em;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    position: sticky;
    top: 120px;
  }
  .pnc-title {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #184333;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid #f97316;
  }
  .pnc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pnc-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 12px;
    color: #475569;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .pnc-link:hover,
  .pnc-link.active {
    background: rgba(249, 115, 22, 0.1);
    color: #f97316;
  }
  .policy-content-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 28px;
    padding: 3em 3.5em;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.04);
  }
  .policy-block-head {
    font-size: 26px;
    font-weight: 800;
    color: #184333;
    margin-top: 2em;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #f1f5f9;
  }
  .policy-block-head:first-child {
    margin-top: 0;
  }
  .policy-text-para {
    font-size: 15px;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .policy-list-item {
    font-size: 15px;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 8px;
  }
  .policy-alert-box {
    background: #fff8e7;
    border-left: 4px solid #f97316;
    border-radius: 12px;
    padding: 16px 20px;
    margin: 24px 0;
  }
  .policy-alert-box strong {
    color: #78350f;
  }
  @media (max-width: 991px) {
    .policy-content-box {
      padding: 2em 1.5em;
    }
    .policy-nav-card {
      position: relative;
      top: 0;
      margin-bottom: 2em;
    }
  }
</style>

<div class="page-hero-banner policy-hero-banner">
  <div class="container">
    <div class="row text-center">
      <div class="col-lg-8 col-12 mx-auto">
        <span class="hero-tag-badge" data-aos="fade-down">Sunlit Farms Compliance</span>
        <h1 class="hero-page-head text-white" data-aos="fade-up" data-aos-delay="100">
          {{ section.settings.page_title | default: "Legal & Brand Policies" }}
        </h1>
        <p class="hero-page-subtext text-white-50" data-aos="fade-up" data-aos-delay="200">
          Transparent guidelines governing quality assurance, B2B procurement, privacy, and customer satisfaction.
        </p>
      </div>
    </div>
  </div>
</div>

<section class="policy-body-sec sec">
  <div class="container">
    <div class="row align-items-start g-5">

      <!-- Navigation Sidebar -->
      <div class="col-lg-4 col-12">
        <div class="policy-nav-card">
          <div class="pnc-title">Policy Index</div>
          <ul class="pnc-list">
            <li>
              <a href="#privacy" class="pnc-link active">
                <span>Privacy Policy</span>
                <span>➔</span>
              </a>
            </li>
            <li>
              <a href="#terms" class="pnc-link">
                <span>Terms of Service</span>
                <span>➔</span>
              </a>
            </li>
            <li>
              <a href="#shipping" class="pnc-link">
                <span>Shipping & Delivery</span>
                <span>➔</span>
              </a>
            </li>
            <li>
              <a href="#refund" class="pnc-link">
                <span>Refund & Return Policy</span>
                <span>➔</span>
              </a>
            </li>
          </ul>

          <div class="mt-4 pt-3 border-top border-light">
            <span class="small text-muted d-block mb-1">Need Clarification?</span>
            <strong class="text-dark d-block">mail@sunlitfarms.com</strong>
            <small class="text-muted">+91 8877665544</small>
          </div>
        </div>
      </div>

      <!-- Main Policy Content -->
      <div class="col-lg-8 col-12">
        <div class="policy-content-box">

          <!-- 1. PRIVACY POLICY -->
          <div id="privacy">
            <h2 class="policy-block-head">1. Privacy Policy</h2>
            <p class="policy-text-para">
              At <strong>Sunlit Farms</strong> (a subsidiary unit of <strong>Akshat Group</strong>), we respect your privacy and are committed to protecting all personal information provided through our official store, retail partners, and B2B wholesale portals.
            </p>
            <p class="policy-text-para">
              <strong>Information We Collect:</strong> We collect contact details (Name, Email, Delivery Address, Phone Number), billing credentials, and commercial business data (GST registration, FSSAI license numbers for wholesale buyers) strictly to process orders and ensure compliance.
            </p>
            <p class="policy-text-para">
              <strong>Data Usage & Protection:</strong> Your information is never sold or rented to third parties. Data is used exclusively for order fulfillment, dispatch tracking, customer support, and FSSAI regulatory compliance auditing.
            </p>
            <div class="policy-alert-box">
              <strong>FSSAI & Regulatory Auditing:</strong> All transaction records involving food staple dispatches are archived for a mandatory statutory period as mandated by FSSAI & Government of India guidelines.
            </div>
          </div>

          <!-- 2. TERMS OF SERVICE -->
          <div id="terms">
            <h2 class="policy-block-head">2. Terms of Service</h2>
            <p class="policy-text-para">
              By accessing the Sunlit Farms portal or placing orders for our milled staples (Atta, Maida, Sooji, Rawa, Dalia), you agree to be bound by the following terms:
            </p>

            <ul class="ps-0 mb-4 ms-3">
              <li class="policy-list-item"><strong>Product Specifications:</strong> Net weights (1kg, 2kg, 5kg, 10kg, 25kg, 50kg bulk bags) are strictly benchmarked at automated packaging stations. Natural variations in grain moisture content may occur due to seasonal climatic changes.</li>
              <li class="policy-list-item"><strong>Wholesale & B2B Procurement:</strong> Bulk orders dispatched to institutional buyers, FMCG distributors, and bakery partners are governed by specific commercial purchase agreements.</li>
              <li class="policy-list-item"><strong>Intellectual Property:</strong> All brand graphics, packaging artwork, logos, and milling process specifications remain the exclusive property of Akshat Group & Sunlit Farms.</li>
            </ul>
          </div>

          <!-- 3. SHIPPING & DELIVERY POLICY -->
          <div id="shipping">
            <h2 class="policy-block-head">3. Shipping & Delivery Policy</h2>
            <p class="policy-text-para">
              We operate state-of-the-art dispatch hubs across Madhya Pradesh (Nimrani Plant) and Uttar Pradesh (Chandauli Plant & Varanasi Facility) to ensure rapid supply across India.
            </p>
            <p class="policy-text-para">
              <strong>Dispatch Timelines:</strong> Retail & sample orders are dispatched within 24 to 48 hours. B2B truckload orders are dispatched according to agreed contract logistics schedules.
            </p>
            <p class="policy-text-para">
              <strong>Transit Protection:</strong> Staple bags are packed in airtight, moisture-resistant protective secondary outer bags to prevent environmental moisture contamination during transit.
            </p>
          </div>

          <!-- 4. REFUND & RETURN POLICY -->
          <div id="refund">
            <h2 class="policy-block-head">4. Refund & Return Policy</h2>
            <p class="policy-text-para">
              As food staples are perishable and subject to strict hygiene regulations, returns are governed by our Food Safety Protocol:
            </p>
            <div class="policy-alert-box">
              <strong>7-Day Quality Claim Window:</strong> In the unlikely event of physical packaging damage during transit or batch quality discrepancies, claims must be reported within <strong>7 days</strong> of delivery with clear photographs and batch lot details.
            </div>
            <p class="policy-text-para">
              <strong>Replacement Protocol:</strong> Verified damaged or defective bags will be replaced free of charge or credited to your account after inspection by our QC team.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Policy Page",
  "tag": "section",
  "class": "policy-page-section",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Heading",
      "default": "Legal & Brand Policies"
    }
  ],
  "presets": [
    {
      "name": "Policy Page"
    }
  ]
}
{% endschema %}
