<section class="pr-cta-sec">
  <div class="container">
    <div class="pr-cta">
      <div class="row align-items-center">

        <!-- LEFT CONTENT -->
        <div class="col-lg-5 col-12">
          <div class="pr-cta-con" data-aos="fade-right" data-aos-duration="1000">

            {% if section.settings.heading != blank %}
              <h3 class="sec-head">
                {{ section.settings.heading }}
              </h3>
            {% endif %}

            <ul class="pr-cta-list">
              {% for block in section.blocks %}
                <li {{ block.shopify_attributes }}>

                  {% if block.settings.icon %}
                    <img 
                      src="{{ block.settings.icon | image_url: width: 80 }}" 
                      alt="{{ block.settings.title | escape }}"
                    >
                  {% endif %}

                  <div>

                    {% if block.settings.title != blank %}
                      <h3>{{ block.settings.title }}</h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <p class="para">
                        {{ block.settings.text }}
                      </p>
                    {% endif %}

                  </div>

                </li>
              {% endfor %}
            </ul>

          </div>
        </div>

        <!-- RIGHT IMAGE -->
        <div class="col-lg-7 col-12">
          <div class="pr-cta-img" data-aos="fade-left" data-aos-duration="1000">

            {% if section.settings.main_image %}
              <img 
                src="{{ section.settings.main_image | image_url: width: 1200 }}" 
                alt="main image"
              >
            {% endif %}

            {% if section.settings.overlay_image %}
              <img 
                src="{{ section.settings.overlay_image | image_url: width: 600 }}" 
                class="pr-pt" 
                alt="overlay"
              >
            {% endif %}

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product CTA",
  "tag": "section",
  "class": "product-cta-advanced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday perfection in your kitchen."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "overlay_image",
      "label": "Overlay Image (optional)"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Soft Rotis"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Ensures soft, fluffy rotis with excellent taste."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product CTA Advanced",
      "category": "Custom",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}