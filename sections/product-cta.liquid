<style>
  .pr-cta-sec {
    padding: 5.5em 0;
    background: #ffffff;
  }
  .pr-cta-wrapper {
    background: linear-gradient(135deg, #184333 0%, #0a241a 100%);
    border-radius: 36px;
    padding: 4.5em 4em;
    position: relative;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(24, 67, 51, 0.25);
  }
  .pr-cta-wrapper::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.15) 0%, rgba(24, 67, 51, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .pcta-sub-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 183, 77, 0.15);
    border: 1px solid rgba(255, 183, 77, 0.3);
    color: #ffb74d;
    font-size: 13px;
    font-weight: 800;
    padding: 6px 18px;
    border-radius: 100px;
    margin-bottom: 16px;
  }
  .pcta-heading {
    font-size: 42px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 28px;
  }
  .pcta-feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .pcta-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 1.4em 1.6em;
    backdrop-filter: blur(10px);
    transition: transform 0.35s ease, border-color 0.35s ease, background 0.35s ease;
  }
  .pcta-feature-item:hover {
    transform: translateX(8px);
    border-color: #f97316;
    background: rgba(255, 255, 255, 0.1);
  }
  .pcta-icon-box {
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: #ffffff;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 8px 20px rgba(249, 115, 22, 0.3);
  }
  .pcta-icon-box img {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }
  .pcta-item-title {
    font-size: 19px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .pcta-item-text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0;
    line-height: 1.5;
  }
  .pcta-image-wrap {
    position: relative;
    text-center: center;
  }
  .pcta-main-img {
    max-width: 100%;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
  }

  @media (max-width: 991px) {
    .pr-cta-wrapper {
      padding: 3em 2em;
    }
    .pcta-heading {
      font-size: 32px;
    }
  }
</style>

<section class="pr-cta-sec">
  <div class="container">
    <div class="pr-cta-wrapper">
      <div class="row align-items-center g-5">

        <!-- LEFT CONTENT -->
        <div class="col-lg-6 col-12">
          <div class="pcta-content" data-aos="fade-right" data-aos-duration="1000">

            <div class="pcta-sub-badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Superior Kitchen Quality</span>
            </div>

            {% if section.settings.heading != blank %}
              <h2 class="pcta-heading">
                {{ section.settings.heading }}
              </h2>
            {% endif %}

            <ul class="pcta-feature-list">
              {% for block in section.blocks %}
                <li class="pcta-feature-item" {{ block.shopify_attributes }}>

                  <div class="pcta-icon-box">
                    {% if block.settings.icon %}
                      <img 
                        src="{{ block.settings.icon | image_url: width: 80 }}" 
                        alt="{{ block.settings.title | escape }}"
                      >
                    {% else %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    {% endif %}
                  </div>

                  <div>
                    {% if block.settings.title != blank %}
                      <h3 class="pcta-item-title">{{ block.settings.title }}</h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <p class="pcta-item-text">
                        {{ block.text | default: block.settings.text }}
                      </p>
                    {% endif %}
                  </div>

                </li>
              {% endfor %}
            </ul>

          </div>
        </div>

        <!-- RIGHT IMAGE -->
        <div class="col-lg-6 col-12">
          <div class="pcta-image-wrap text-center" data-aos="fade-left" data-aos-duration="1000">

            {% if section.settings.main_image %}
              <img 
                src="{{ section.settings.main_image | image_url: width: 1200 }}" 
                class="pcta-main-img" 
                alt="Sunlit Farms Atta Packaging"
              >
            {% else %}
              <img 
                src="https://cdn.shopify.com/s/files/1/0000/0000/files/prr.png" 
                class="pcta-main-img" 
                alt="Sunlit Farms Atta Packaging"
              >
            {% endif %}

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product CTA",
  "tag": "section",
  "class": "product-cta-advanced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday perfection in your kitchen."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "overlay_image",
      "label": "Overlay Image (optional)"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Soft Rotis"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Ensures soft, fluffy rotis with excellent taste."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product CTA Advanced",
      "category": "Custom",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}