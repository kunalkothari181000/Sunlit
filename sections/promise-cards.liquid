<section class="sec test-sec">
  
  {% if section.settings.top_bg %}
    <img 
      src="{{ section.settings.top_bg | image_url: width: 1920 }}" 
      class="w-100 test-green-bg" 
      alt="background"
    >
  {% endif %}

  <div class="test-slider-sec">
    <div class="sec pt-0">
      <div class="container">

        <!-- Heading -->
        <div class="row mb-5">
          <div class="col-12 text-center">
            
            {% if section.settings.subheading != blank %}
              <span class="promise-subheading" data-aos="fade-up" data-aos-duration="800">
                {{ section.settings.subheading }}
              </span>
            {% endif %}

            {% if section.settings.heading != blank %}
              <h2 class="sec-head promise-heading white" data-aos="fade-up" data-aos-duration="800" data-aos-delay="100">
                {{ section.settings.heading }}
              </h2>
            {% endif %}

          </div>
        </div>

        <!-- Cards -->
        <div class="row g-4 justify-content-center">
          {% for block in section.blocks %}
            <div class="col-lg-3 col-md-6 col-12 d-flex" {{ block.shopify_attributes }}>
              <div class="d-card w-100" data-aos="fade-up" data-aos-delay="{{ forloop.index | times: 100 }}">
                <div class="d-card-top-bar"></div>

                {% if block.settings.image %}
                  <div class="d-card-top-right-img">
                    <img 
                      src="{{ block.settings.image | image_url: width: 300 }}" 
                      alt="{{ block.settings.title | escape }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                <div class="con">

                  {% if block.settings.title != blank %}
                    <h2>{{ block.settings.title }}</h2>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <p class="para">
                      {{ block.settings.text }}
                    </p>
                  {% endif %}

                </div>

              </div>
            </div>
          {% endfor %}
        </div>

      </div>
    </div>

    {% if section.settings.bottom_bg %}
      <img 
        src="{{ section.settings.bottom_bg | image_url: width: 1920 }}" 
        class="w-100 test-grass-bg" 
        alt="background"
      >
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Promise Cards Section",
  "tag": "section",
  "class": "promise-cards-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_bg",
      "label": "Top Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Sunlit Farms Difference"
    },
    {
      "type": "image_picker",
      "id": "bottom_bg",
      "label": "Bottom Background Image"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hygienic Processing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Advanced milling systems with strict quality checks to maintain purity."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promise Cards Section",
      "category": "Custom",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}