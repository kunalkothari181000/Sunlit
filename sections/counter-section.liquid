<section class="counter-sec">
  <div class="container">
    <div class="row g-4 justify-content-center">
      
      {% for block in section.blocks %}
        <div class="col-lg-3 col-md-6 col-12" {{ block.shopify_attributes }}>
          <div class="counter-card" data-aos="fade-up" data-aos-delay="{{ forloop.index | times: 100 }}">
            
            {% if block.settings.icon != blank %}
              <div class="counter-card-header mb-3">
                <div class="counter-icon-box">
                  <img src="{{ block.settings.icon | image_url: width: 60 }}" alt="{{ block.settings.label }}" loading="lazy">
                </div>
              </div>
            {% endif %}

            <div class="counter-card-body">
              {% if block.settings.value != blank %}
                <h3 class="count" 
                    data-count="{{ block.settings.datavalue }}" 
                    data-suffix="{{ block.settings.suffix | default: '+' }}"
                    data-raw-value="{{ block.settings.value }}">
                  {{ block.settings.value }}
                </h3>
              {% endif %}

              {% if block.settings.label != blank %}
                <p class="para">{{ block.settings.label }}</p>
              {% endif %}
            </div>

          </div>
        </div>
      {% endfor %}

    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const counters = document.querySelectorAll('.counter-sec .count');

  const animateCount = (el) => {
    const rawVal = el.getAttribute('data-raw-value') || el.textContent.trim();
    const dataValAttr = el.getAttribute('data-count');
    
    // Check if there is a valid numeric target
    let targetNum = parseFloat(dataValAttr);
    if (isNaN(targetNum)) {
      const match = rawVal.match(/[\d\.]+/);
      targetNum = match ? parseFloat(match[0]) : null;
    }

    if (targetNum === null || isNaN(targetNum)) {
      el.textContent = rawVal;
      return;
    }

    // Extract suffix or non-digit trailing chars
    let suffix = el.getAttribute('data-suffix');
    if (!suffix || suffix === '+') {
      const nonDigits = rawVal.replace(/[\d\.\s]/g, '');
      suffix = nonDigits || '+';
    }

    const duration = 2200;
    const startTime = performance.now();
    const isDecimal = targetNum % 1 !== 0;

    const update = (currentTime) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Exponential ease-out
      const easedProgress = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
      const currentVal = easedProgress * targetNum;

      const formattedVal = isDecimal ? currentVal.toFixed(1) : Math.floor(currentVal);
      el.textContent = formattedVal + suffix;

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        el.textContent = (isDecimal ? targetNum.toFixed(1) : targetNum) + suffix;
      }
    };

    requestAnimationFrame(update);
  };

  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animateCount(entry.target);
        obs.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.3
  });

  counters.forEach(counter => observer.observe(counter));
});
</script>

{% schema %}
{
  "name": "Counter Section",
  "tag": "section",
  "class": "counter-section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "counter",
      "name": "Counter Item",
      "settings": [
        {
          "type": "text",
          "id": "datavalue",
          "label": "Numeric Target",
          "default": "15",
          "info": "Number to count up to (e.g., 28, 85, 1200, 16)"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix / Unit",
          "default": "+",
          "info": "e.g., +, MT, Years, %"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Display Value (Fallback)",
          "default": "15+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "States Distribution"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Optional Custom Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Counter Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "counter",
          "settings": {
            "datavalue": "28",
            "suffix": "+",
            "value": "28+",
            "label": "Years of Manufacturing Excellence"
          }
        },
        {
          "type": "counter",
          "settings": {
            "datavalue": "85",
            "suffix": "+",
            "value": "85+",
            "label": "Distribution Partners"
          }
        },
        {
          "type": "counter",
          "settings": {
            "datavalue": "1200",
            "suffix": "MT",
            "value": "1200MT",
            "label": "Daily Grinding Capacity"
          }
        },
        {
          "type": "counter",
          "settings": {
            "datavalue": "16",
            "suffix": "+",
            "value": "16+",
            "label": "States Market Presence"
          }
        }
      ]
    }
  ]
}
{% endschema %}