<section class="main-header
  {% if section.settings.small_header %} inner-header{% endif %}
">
 
    {% if section.settings.banner_image %}
      <img 
        src="{{ section.settings.banner_image | image_url: width: 1920 }}" 
        alt="{{ section.settings.heading | escape }}" 
        loading="lazy"
      >
    {% endif %}

    <img src="{{ 'bn-pt.svg' | asset_url }}" alt="" class="bn-pt">
 

  <div class="container">
    <div class="row align-items-center justify-content-center">
      <div class="col-lg-8 col-12">
        <div class="banner-con">
          <div class="banner-con-wrap" data-aos="fade-up" data-aos-duration="1000">
            
            {% if section.settings.heading != blank %}
              <h1>{{ section.settings.heading }}</h1>
            {% endif %}

            {% if section.settings.subtext != blank %}
              <p class="para">{{ section.settings.subtext }}</p>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <a href="{{ section.settings.button_link }}" class="main-btn center">
                <span>{{ section.settings.button_label }}</span>

                {% if section.settings.button_icon %}
                  <img 
                    src="{{ section.settings.button_icon | image_url: width: 20 }}" 
                    alt="icon"
                  >
                {% endif %}
              </a>
            {% endif %}

          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-banner-section",
  "settings": [
     {
      "type": "checkbox",
      "id": "small_header",
      "label": "Small Header",
      "default": false
      },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reliable Agricultural Sourcing."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Hygienically processed from carefully selected wheat to ensure purity, freshness, and consistent quality in every pack."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "Button Icon"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}