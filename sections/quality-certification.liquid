<style>
  .qual-sec {
    background: #f8fafc;
    padding: 6em 0;
    position: relative;
  }
  .qual-left-sticky {
    position: sticky !important;
    top: 120px !important;
    align-self: flex-start !important;
  }
  .qual-images-composite {
    position: relative;
    min-height: 340px;
    margin-top: 2em;
  }
  .q-img-primary {
    width: 78%;
    border-radius: 28px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.1);
    object-fit: cover;
  }
  .q-img-secondary {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    border-radius: 24px;
    border: 5px solid #ffffff;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
    object-fit: cover;
  }
  .q-badge-floating {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #184333;
    color: #ffb74d;
    font-size: 12px;
    font-weight: 800;
    padding: 8px 18px;
    border-radius: 100px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 25px rgba(24, 67, 51, 0.35);
  }
  .qual-cards-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 1.6em !important;
  }
  .qual-card-item {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    gap: 24px !important;
    background: #ffffff !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 26px !important;
    padding: 2.2em 2.4em !important;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.04) !important;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    overflow: hidden !important;
  }
  .qual-card-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: linear-gradient(180deg, #f97316 0%, #184333 100%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .qual-card-item:hover {
    transform: translateX(10px) translateY(-3px) !important;
    border-color: #f97316 !important;
    box-shadow: 0 25px 60px rgba(249, 115, 22, 0.12) !important;
  }
  .qual-card-item:hover::before {
    opacity: 1;
  }
  .qc-icon-box {
    width: 64px !important;
    height: 64px !important;
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.14) 0%, rgba(255, 183, 77, 0.2) 100%) !important;
    color: #f97316 !important;
    border-radius: 20px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    box-shadow: 0 6px 18px rgba(249, 115, 22, 0.15) !important;
    transition: transform 0.35s ease, background 0.35s ease !important;
  }
  .qual-card-item:hover .qc-icon-box {
    transform: scale(1.1) rotate(-4deg) !important;
    background: linear-gradient(135deg, #184333 0%, #0f2c22 100%) !important;
    color: #ffb74d !important;
  }
  .qc-content {
    flex-grow: 1 !important;
  }
  .qc-header-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    margin-bottom: 6px !important;
  }
  .qc-content h3 {
    font-size: 22px !important;
    font-weight: 800 !important;
    color: #184333 !important;
    margin-bottom: 0 !important;
    line-height: 1.2 !important;
  }
  .qc-tag {
    font-size: 11px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    color: #184333 !important;
    background: rgba(24, 67, 51, 0.08) !important;
    padding: 4px 12px !important;
    border-radius: 100px !important;
  }
  .qc-content .para {
    font-size: 15px !important;
    color: #475569 !important;
    margin-bottom: 0 !important;
    line-height: 1.55 !important;
  }
  .qc-check-icon {
    width: 38px !important;
    height: 38px !important;
    background: linear-gradient(135deg, #184333 0%, #0a241a 100%) !important;
    color: #ffb74d !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    box-shadow: 0 6px 16px rgba(24, 67, 51, 0.2) !important;
    transition: transform 0.35s ease, background 0.35s ease !important;
  }
  .qual-card-item:hover .qc-check-icon {
    transform: scale(1.15) !important;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%) !important;
    color: #ffffff !important;
  }
  @media (max-width: 991px) {
    .qual-left-sticky {
      position: relative !important;
      top: 0 !important;
    }
  }
</style>

<section class="qual-sec sec">
  <div class="container">
    <div class="row align-items-start g-5">

      <!-- LEFT CONTENT & IMAGES (Sticky Sidebar) -->
      <div class="col-lg-5 col-12">
        <div class="qual-left-sticky">
          
          <span class="sub-pill mb-2">Food Safety Standards</span>
          
          {% if section.settings.heading != blank %}
            <h2 class="sec-head d-inline-block with-gr">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.text != blank %}
            <p class="para my-3">
              {{ section.settings.text }}
            </p>
          {% endif %}

          <div class="qual-images-composite mt-4">
            {% if section.settings.image %}
              <img 
                src="{{ section.settings.image | image_url: width: 800 }}" 
                class="q-img-primary" 
                alt="Quality Inspection"
              >
            {% endif %}
            {% if section.settings.image2 %}
              <img 
                src="{{ section.settings.image2 | image_url: width: 800 }}" 
                class="q-img-secondary" 
                alt="Lab Testing"
              >
            {% endif %}
            <div class="q-badge-floating">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>100% Quality Inspected</span>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT CERTIFICATION CARDS (Ultra-Modern Premium Cards) -->
      <div class="col-lg-7 col-12">
        <div class="qual-cards-list">
          {% for block in section.blocks %}
            <div 
              class="qual-card-item" 
              data-aos="fade-up" 
              data-aos-duration="800" 
              data-aos-delay="{{ forloop.index0 | times: 120 }}" 
              {{ block.shopify_attributes }}
            >

              <div class="qc-icon-box">
                {% if block.settings.icon %}
                  <img 
                    src="{{ block.settings.icon | image_url: width: 120 }}" 
                    alt="{{ block.settings.title | escape }}"
                  >
                {% else %}
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endif %}
              </div>

              <div class="qc-content">
                <div class="qc-header-row">
                  {% if block.settings.title != blank %}
                    <h3>{{ block.settings.title }}</h3>
                  {% endif %}
                  <span class="qc-tag">Verified</span>
                </div>

                {% if block.settings.text != blank %}
                  <p class="para">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
              </div>

              <div class="qc-check-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </div>

            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quality & Certification",
  "tag": "section",
  "class": "quality-certification-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality You Can Trust"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Every batch is backed by strict quality controls, advanced testing infrastructure, and internationally recognised food safety standards."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Primary Image"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Secondary Image"
    }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FSSC 22000"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "International food safety certification ensuring complete traceablity and hygiene."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality & Certification",
      "category": "Custom",
      "blocks": [
        { "type": "cert" },
        { "type": "cert" },
        { "type": "cert" }
      ]
    }
  ]
}
{% endschema %}