<style>
  .qual-sec {
    background: #f8fafc;
    padding: 6em 0;
    position: relative;
  }
  .qual-left-wrap {
    position: relative;
  }
  .qual-images-composite {
    position: relative;
    min-height: 340px;
    margin-top: 2em;
  }
  .q-img-primary {
    width: 78%;
    border-radius: 24px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.08);
    object-fit: cover;
  }
  .q-img-secondary {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    border-radius: 20px;
    border: 4px solid #ffffff;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.1);
    object-fit: cover;
  }
  .q-badge-floating {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #184333;
    color: #ffb74d;
    font-size: 12px;
    font-weight: 800;
    padding: 8px 18px;
    border-radius: 100px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 25px rgba(24, 67, 51, 0.3);
  }

  /* NEW BESPOKE CERTIFICATE CARDS */
  .qual-cards-container {
    display: flex;
    flex-direction: column;
    gap: 1.4em;
  }
  .cert-card-modern {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 1.8em 2em;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    display: flex;
    align-items: center;
    gap: 20px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
  }
  .cert-card-modern:hover {
    transform: translateY(-4px);
    border-color: #f97316;
    box-shadow: 0 18px 45px rgba(249, 115, 22, 0.1);
  }
  .cert-icon-circle {
    width: 54px;
    height: 54px;
    background: #fff7ed;
    color: #ea580c;
    border: 1px solid #ffedd5;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .cert-card-modern:hover .cert-icon-circle {
    background: #184333;
    color: #ffb74d;
    border-color: #184333;
  }
  .cert-info-body {
    flex-grow: 1;
  }
  .cert-info-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }
  .cert-title {
    font-size: 19px;
    font-weight: 800;
    color: #184333;
    margin-bottom: 0;
    line-height: 1.3;
  }
  .cert-status-badge {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #15803d;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 3px 12px;
    border-radius: 100px;
  }
  .cert-desc {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 0;
    line-height: 1.5;
  }
  .cert-check-mark {
    width: 32px;
    height: 32px;
    background: #f0fdf4;
    color: #16a34a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .cert-card-modern {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5em;
    }
    .cert-info-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>

<section class="qual-sec sec">
  <div class="container">
    <div class="row align-items-center g-5">

      <!-- LEFT CONTENT & IMAGES -->
      <div class="col-lg-5 col-12">
        <div class="qual-left-wrap">
          
          <span class="sub-pill mb-2">Food Safety Standards</span>
          
          {% if section.settings.heading != blank %}
            <h2 class="sec-head d-inline-block with-gr mb-3">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.text != blank %}
            <p class="para mb-4">
              {{ section.settings.text }}
            </p>
          {% endif %}

          <div class="qual-images-composite">
            {% if section.settings.image %}
              <img 
                src="{{ section.settings.image | image_url: width: 800 }}" 
                class="q-img-primary" 
                alt="Quality Inspection"
              >
            {% endif %}
            {% if section.settings.image2 %}
              <img 
                src="{{ section.settings.image2 | image_url: width: 800 }}" 
                class="q-img-secondary" 
                alt="Lab Testing"
              >
            {% endif %}
            <div class="q-badge-floating">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>100% Quality Inspected</span>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT CERTIFICATION CARDS (Clean, Modern UI) -->
      <div class="col-lg-7 col-12">
        <div class="qual-cards-container">
          {% for block in section.blocks %}
            <div 
              class="cert-card-modern" 
              data-aos="fade-up" 
              data-aos-duration="800" 
              data-aos-delay="{{ forloop.index0 | times: 120 }}" 
              {{ block.shopify_attributes }}
            >

              <div class="cert-icon-circle">
                {% if block.settings.icon %}
                  <img 
                    src="{{ block.settings.icon | image_url: width: 100 }}" 
                    alt="{{ block.settings.title | escape }}"
                    style="width: 28px; height: 28px; object-fit: contain;"
                  >
                {% else %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endif %}
              </div>

              <div class="cert-info-body">
                <div class="cert-info-header">
                  {% if block.settings.title != blank %}
                    <h3 class="cert-title">{{ block.settings.title }}</h3>
                  {% endif %}
                  <span class="cert-status-badge">Certified</span>
                </div>

                {% if block.settings.text != blank %}
                  <p class="cert-desc">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
              </div>

              <div class="cert-check-mark">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </div>

            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quality & Certification",
  "tag": "section",
  "class": "quality-certification-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality You Can Trust"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Every batch is backed by strict quality controls, advanced testing infrastructure, and internationally recognised food safety standards."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Primary Image"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Secondary Image"
    }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FSSC 22000"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "International food safety certification ensuring complete traceablity and hygiene."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality & Certification",
      "category": "Custom",
      "blocks": [
        { "type": "cert" },
        { "type": "cert" },
        { "type": "cert" }
      ]
    }
  ]
}
{% endschema %}