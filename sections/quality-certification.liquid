<section class="qual-sec sec">
  <div class="container">
    <div class="row align-items-center g-5">

      <!-- LEFT CONTENT & IMAGES -->
      <div class="col-lg-5 col-12" data-aos="fade-right" data-aos-duration="1000">
        <div class="qual-left-wrap">
          
          <span class="sub-pill">Food Safety Standards</span>
          
          {% if section.settings.heading != blank %}
            <h2 class="sec-head d-inline-block with-gr">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.text != blank %}
            <p class="para my-3">
              {{ section.settings.text }}
            </p>
          {% endif %}

          <div class="qual-images-composite mt-4">
            {% if section.settings.image %}
              <img 
                src="{{ section.settings.image | image_url: width: 800 }}" 
                class="q-img-primary" 
                alt="Quality Inspection"
              >
            {% endif %}
            {% if section.settings.image2 %}
              <img 
                src="{{ section.settings.image2 | image_url: width: 800 }}" 
                class="q-img-secondary" 
                alt="Lab Testing"
              >
            {% endif %}
            <div class="q-badge-floating">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>100% Quality Inspected</span>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT CERTIFICATION CARDS -->
      <div class="col-lg-7 col-12" data-aos="fade-left" data-aos-duration="1000">
        <div class="qual-cards-list">
          {% for block in section.blocks %}
            <div class="qual-card-item" {{ block.shopify_attributes }}>

              <div class="qc-icon-box">
                {% if block.settings.icon %}
                  <img 
                    src="{{ block.settings.icon | image_url: width: 120 }}" 
                    alt="{{ block.settings.title | escape }}"
                  >
                {% else %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endif %}
              </div>

              <div class="qc-content">
                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="para">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
              </div>

              <div class="qc-check-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </div>

            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quality & Certification",
  "tag": "section",
  "class": "quality-certification-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality You Can Trust"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Every batch is backed by strict quality controls, advanced testing infrastructure, and internationally recognised food safety standards."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Primary Image"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Secondary Image"
    }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FSSC 22000"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "International food safety certification ensuring complete traceablity and hygiene."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality & Certification",
      "category": "Custom",
      "blocks": [
        { "type": "cert" },
        { "type": "cert" },
        { "type": "cert" }
      ]
    }
  ]
}
{% endschema %}