<style>
  .qual-sec {
    background: #f8fafc;
    padding: 6em 0;
    position: relative;
  }
  .qual-left-sticky {
    position: sticky !important;
    top: 130px !important;
    align-self: flex-start !important;
  }
  .qual-images-composite {
    position: relative;
    min-height: 320px;
    margin-top: 2em;
  }
  .q-img-primary {
    width: 75%;
    border-radius: 24px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.1);
    object-fit: cover;
  }
  .q-img-secondary {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 50%;
    border-radius: 20px;
    border: 4px solid #ffffff;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
    object-fit: cover;
  }
  .q-badge-floating {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #184333;
    color: #ffb74d;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 100px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 20px rgba(24, 67, 51, 0.3);
  }
  .qual-cards-stack-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-bottom: 2em;
  }
  .qual-card-item-stack {
    position: sticky !important;
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 24px !important;
    padding: 2.2em 2.2em !important;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08) !important;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease !important;
    display: flex !important;
    align-items: center !important;
    gap: 24px !important;
  }
  .qual-card-item-stack:hover {
    transform: translateY(-4px) scale(1.02) !important;
    border-color: #f97316 !important;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12) !important;
  }
  .qc-icon-box {
    width: 60px !important;
    height: 60px !important;
    background: rgba(249, 115, 22, 0.12) !important;
    color: #f97316 !important;
    border-radius: 18px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
  }
  .qc-content {
    flex-grow: 1 !important;
  }
  .qc-content h3 {
    font-size: 22px !important;
    font-weight: 800 !important;
    color: #184333 !important;
    margin-bottom: 6px !important;
  }
  .qc-content .para {
    font-size: 15px !important;
    color: #475569 !important;
    margin-bottom: 0 !important;
    line-height: 1.5 !important;
  }
  .qc-check-icon {
    width: 36px !important;
    height: 36px !important;
    background: rgba(24, 67, 51, 0.08) !important;
    color: #184333 !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
  }
</style>

<section class="qual-sec sec">
  <div class="container">
    <div class="row align-items-start g-5">

      <!-- LEFT CONTENT & IMAGES (Sticky Sidebar) -->
      <div class="col-lg-5 col-12">
        <div class="qual-left-sticky">
          
          <span class="sub-pill mb-2">Food Safety Standards</span>
          
          {% if section.settings.heading != blank %}
            <h2 class="sec-head d-inline-block with-gr">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.text != blank %}
            <p class="para my-3">
              {{ section.settings.text }}
            </p>
          {% endif %}

          <div class="qual-images-composite mt-4">
            {% if section.settings.image %}
              <img 
                src="{{ section.settings.image | image_url: width: 800 }}" 
                class="q-img-primary" 
                alt="Quality Inspection"
              >
            {% endif %}
            {% if section.settings.image2 %}
              <img 
                src="{{ section.settings.image2 | image_url: width: 800 }}" 
                class="q-img-secondary" 
                alt="Lab Testing"
              >
            {% endif %}
            <div class="q-badge-floating">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>100% Quality Inspected</span>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT CERTIFICATION CARDS (Sticky Overlapping Stack) -->
      <div class="col-lg-7 col-12">
        <div class="qual-cards-stack-list">
          {% for block in section.blocks %}
            {% assign top_offset = 140 | plus: forloop.index0 | times: 28 %}
            <div 
              class="qual-card-item-stack" 
              style="top: {{ top_offset }}px; z-index: {{ forloop.index }};" 
              data-aos="fade-up" 
              data-aos-duration="800" 
              {{ block.shopify_attributes }}
            >

              <div class="qc-icon-box">
                {% if block.settings.icon %}
                  <img 
                    src="{{ block.settings.icon | image_url: width: 120 }}" 
                    alt="{{ block.settings.title | escape }}"
                  >
                {% else %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endif %}
              </div>

              <div class="qc-content">
                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p class="para">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
              </div>

              <div class="qc-check-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </div>

            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quality & Certification",
  "tag": "section",
  "class": "quality-certification-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality You Can Trust"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Every batch is backed by strict quality controls, advanced testing infrastructure, and internationally recognised food safety standards."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Primary Image"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Secondary Image"
    }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FSSC 22000"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "International food safety certification ensuring complete traceablity and hygiene."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality & Certification",
      "category": "Custom",
      "blocks": [
        { "type": "cert" },
        { "type": "cert" },
        { "type": "cert" }
      ]
    }
  ]
}
{% endschema %}