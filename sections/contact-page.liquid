<div class="page-hero-banner">
  <div class="container">
    <div class="row text-center">
      <div class="col-lg-8 col-12 mx-auto">
        <span class="hero-tag-badge" data-aos="fade-down" data-aos-duration="1000">Connect With Us</span>
        <h1 class="hero-page-head text-white" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          Get in Touch
        </h1>
        <p class="hero-page-subtext text-white-50" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
          Reach out for distributorship, bulk procurement, or general inquiries. Our team responds within 24 hours.
        </p>
      </div>
    </div>
  </div>
</div>

<section class="contact-sec sec">
  <div class="container">

    <!-- Interactive Contact Channels -->
    <div class="row g-4 mb-5">
      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="800">
        <a href="tel:{{ section.settings.phone | default: '+91 8877665544' }}" class="contact-card-interactive">
          <div class="cc-icon-wrap">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="cc-content">
            <span class="cc-label">Call Support</span>
            <h3 class="cc-val">{{ section.settings.phone | default: "+91 8877665544" }}</h3>
            <span class="cc-sub">Mon - Sat from 9am to 6pm</span>
          </div>
          <div class="cc-arrow">➔</div>
        </a>
      </div>

      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="100">
        <a href="mailto:{{ section.settings.email | default: 'mail@sunlitfarms.com' }}" class="contact-card-interactive">
          <div class="cc-icon-wrap">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="cc-content">
            <span class="cc-label">Email Support</span>
            <h3 class="cc-val">{{ section.settings.email | default: "mail@sunlitfarms.com" }}</h3>
            <span class="cc-sub">Quick 24-hour response</span>
          </div>
          <div class="cc-arrow">➔</div>
        </a>
      </div>

      <div class="col-lg-4 col-md-12 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
        <div class="contact-card-interactive">
          <div class="cc-icon-wrap">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="cc-content">
            <span class="cc-label">Parent Company</span>
            <h3 class="cc-val">Akshat Group</h3>
            <span class="cc-sub">Sunlit Farms Subsidiary Unit</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Form & Factory Locations Grid -->
    <div class="row g-4 align-items-stretch">
      
      <!-- Sleek Glass Form -->
      <div class="col-lg-6 col-12" data-aos="fade-right" data-aos-duration="1000">
        <div class="contact-glass-form-box">
          <h2 class="c-box-title">Send a Direct Inquiry</h2>
          <p class="para mb-4">Select your inquiry type and our regional representative will connect with you.</p>

          <form method="post" action="/contact#contact_form" id="contact_form" accept-charset="UTF-8" class="glass-form-grid">
            <input type="hidden" name="form_type" value="contact">
            <input type="hidden" name="utf8" value="✓">

            <div class="form-floating mb-3">
              <input type="text" name="contact[name]" class="form-control" id="c_name" placeholder="Full Name" required>
              <label for="c_name">Full Name</label>
            </div>

            <div class="row">
              <div class="col-md-6 col-12 mb-3">
                <div class="form-floating">
                  <input type="email" name="contact[email]" class="form-control" id="c_email" placeholder="Email Address" required>
                  <label for="c_email">Email Address</label>
                </div>
              </div>
              <div class="col-md-6 col-12 mb-3">
                <div class="form-floating">
                  <input type="tel" name="contact[phone]" class="form-control" id="c_phone" placeholder="Phone Number" required>
                  <label for="c_phone">Phone Number</label>
                </div>
              </div>
            </div>

            <div class="form-floating mb-3">
              <select name="contact[inquiry_type]" class="form-select" id="c_type">
                <option value="Distributorship / Dealership">Distributorship / Dealership</option>
                <option value="Institutional & B2B Supply">Institutional & B2B Supply</option>
                <option value="Retail Partnership">Retail Partnership</option>
                <option value="General Support">General Support</option>
              </select>
              <label for="c_type">Inquiry Category</label>
            </div>

            <div class="form-floating mb-4">
              <textarea name="contact[body]" class="form-control" id="c_msg" placeholder="Your Message" style="height: 120px" required></textarea>
              <label for="c_msg">Your Message</label>
            </div>

            <button type="submit" class="main-btn orange-btn w-100 py-3 fs-6">
              <span>Submit Inquiry</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Factory & Manufacturing Units Locations -->
      <div class="col-lg-6 col-12" data-aos="fade-left" data-aos-duration="1000">
        <div class="contact-plants-box">
          <h2 class="c-box-title">Our Factory Locations</h2>
          <p class="para mb-4">Licensed processing plants & dispatch hubs in Madhya Pradesh & Uttar Pradesh.</p>

          <div class="c-plant-item">
            <span class="cp-tag">Nimrani Plant • MP</span>
            <h4>AAM - Akshat Agro Milling Co. Pvt. Ltd.</h4>
            <p class="cp-addr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              1 to 8 and 23 to 33, AKVN Food Park, VILL - Nimrani, Dist - Khargone. 451001, Madhya Pradesh
            </p>
            <div class="cp-fssai">
              <span>FSSAI Lic. No.</span>
              <strong>11414890000281</strong>
            </div>
          </div>

          <div class="c-plant-item">
            <span class="cp-tag">Chandauli Plant • UP</span>
            <h4>ARF - Akshat Roller Flour Mill Pvt. Ltd.</h4>
            <p class="cp-addr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              A-4(A), Industrial Area, Ramnagar, Chandauli. 221110, Uttar Pradesh
            </p>
            <div class="cp-fssai">
              <span>FSSAI Lic. No.</span>
              <strong>12720039000182</strong>
            </div>
          </div>

          <div class="c-plant-item mb-0">
            <span class="cp-tag">Varanasi Hub • UP</span>
            <h4>Simran Food Pvt. Ltd.</h4>
            <p class="cp-addr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              P 101/1, Vill - Sujabad, Parao, Varanasi. 221001, Uttar Pradesh
            </p>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "tag": "section",
  "class": "contact-page-section",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+91 8877665544"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "mail@sunlitfarms.com"
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
