<section class="contact-sec sec">
  <div class="container">
    
    <!-- Hero Title -->
    <div class="row text-center mb-5">
      <div class="col-lg-8 col-12 mx-auto">
        <h1 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
          {{ section.settings.heading | default: "Contact Sunlit Farms" }}
        </h1>
        <p class="para mt-3" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          {{ section.settings.subtext | default: "Have questions about our products, bulk distributorship, or institutional supply? Get in touch with our team." }}
        </p>
      </div>
    </div>

    <!-- Quick Info Cards -->
    <div class="row g-4 mb-5">
      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000">
        <div class="contact-info-card">
          <div class="c-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3>Phone Inquiry</h3>
          <p class="para">Mon - Sat from 9am to 6pm</p>
          <a href="tel:{{ section.settings.phone }}" class="c-link">{{ section.settings.phone | default: "+91 8877665544" }}</a>
        </div>
      </div>

      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
        <div class="contact-info-card">
          <div class="c-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3>Email Us</h3>
          <p class="para">Our team typically responds within 24 hrs</p>
          <a href="mailto:{{ section.settings.email }}" class="c-link">{{ section.settings.email | default: "mail@sunlitfarms.com" }}</a>
        </div>
      </div>

      <div class="col-lg-4 col-md-12 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
        <div class="contact-info-card">
          <div class="c-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Corporate Parent</h3>
          <p class="para">A Unit of Akshat Group</p>
          <span class="c-link">Akshat Group Corporate Division</span>
        </div>
      </div>
    </div>

    <!-- Contact Form & Plant Locations -->
    <div class="row g-4 align-items-stretch">
      
      <!-- Contact Form -->
      <div class="col-lg-6 col-12" data-aos="fade-right" data-aos-duration="1000">
        <div class="contact-form-wrap">
          <h2 class="form-head">Send Us a Message</h2>
          <p class="para mb-4">Interested in distribution or bulk procurement? Fill out the form below.</p>
          
          <form method="post" action="/contact#contact_form" id="contact_form" accept-charset="UTF-8" class="c-form">
            <input type="hidden" name="form_type" value="contact">
            <input type="hidden" name="utf8" value="✓">

            <div class="mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" name="contact[name]" class="form-control" placeholder="Enter your full name" required>
            </div>

            <div class="row">
              <div class="col-md-6 col-12 mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="contact[email]" class="form-control" placeholder="name@example.com" required>
              </div>
              <div class="col-md-6 col-12 mb-3">
                <label class="form-label">Phone Number</label>
                <input type="tel" name="contact[phone]" class="form-control" placeholder="+91 9876543210" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Inquiry Type</label>
              <select name="contact[inquiry_type]" class="form-select">
                <option value="Distributorship / Dealership">Distributorship / Dealership</option>
                <option value="Institutional & B2B Supply">Institutional & B2B Supply</option>
                <option value="Retail Inquiry">Retail Inquiry</option>
                <option value="General Support">General Support</option>
              </select>
            </div>

            <div class="mb-4">
              <label class="form-label">Message</label>
              <textarea name="contact[body]" class="form-control" rows="4" placeholder="Tell us about your requirements..." required></textarea>
            </div>

            <button type="submit" class="main-btn orange-btn w-100">
              <span>Send Message</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Factory & Plant Addresses -->
      <div class="col-lg-6 col-12" data-aos="fade-left" data-aos-duration="1000">
        <div class="factory-locations-card">
          <h2 class="form-head">Our Manufacturing Units</h2>
          <p class="para mb-4">State-of-the-art milling plants located across key agricultural hubs in India.</p>

          <div class="factory-item">
            <div class="f-badge">Unit 1 • Madhya Pradesh</div>
            <h4>AAM - Akshat Agro Milling Company Pvt. Ltd.</h4>
            <p class="f-addr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              1 to 8 and 23 to 33, AKVN Food Park, VILL - Nimrani, Dist - Khargone. 451001, Madhya Pradesh
            </p>
            <div class="fssai-box">
              <span class="fssai-label">FSSAI Lic. No.</span>
              <span class="fssai-num">11414890000281</span>
            </div>
          </div>

          <div class="factory-item">
            <div class="f-badge">Unit 2 • Uttar Pradesh</div>
            <h4>ARF - Akshat Roller Flour Mill Pvt. Ltd.</h4>
            <p class="f-addr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              A-4(A), Industrial Area, Ramnagar, Chandauli. 221110, Uttar Pradesh
            </p>
            <div class="fssai-box">
              <span class="fssai-label">FSSAI Lic. No.</span>
              <span class="fssai-num">12720039000182</span>
            </div>
          </div>

          <div class="factory-item">
            <div class="f-badge">Unit 3 • Uttar Pradesh</div>
            <h4>Simran Food Pvt. Ltd.</h4>
            <p class="f-addr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              P 101/1, Vill - Sujabad, Parao, Varanasi. 221001, Uttar Pradesh
            </p>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "tag": "section",
  "class": "contact-page-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Sunlit Farms"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have questions about our products, bulk distributorship, or institutional supply? Get in touch with our team."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+91 8877665544"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "mail@sunlitfarms.com"
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
