<style>
  .maida-spec-sec {
    background: #f0f9ff;
    padding: 5.5em 0;
    border-top: 1px solid #bae6fd;
    border-bottom: 1px solid #bae6fd;
  }
  .maida-badge-strip {
    display: flex;
    justify-content: center;
    gap: 1.4em;
    flex-wrap: wrap;
    margin-bottom: 3.5em;
  }
  .mb-badge-item {
    background: #ffffff;
    border: 1.5px solid #0284c7;
    color: #0369a1;
    padding: 10px 22px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.1);
  }
  .mb-badge-item svg {
    color: #0284c7;
  }
  .maida-process-card {
    background: #ffffff;
    border: 1px solid #bae6fd;
    border-radius: 26px;
    padding: 2.2em 1.8em;
    box-shadow: 0 12px 35px rgba(2, 132, 199, 0.06);
    height: 100%;
    transition: transform 0.35s ease, border-color 0.35s ease;
  }
  .maida-process-card:hover {
    transform: translateY(-6px);
    border-color: #0284c7;
  }
  .mpc-icon-wrap {
    width: 60px;
    height: 60px;
    background: #e0f2fe;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0284c7;
    margin-bottom: 18px;
    overflow: hidden;
  }
  .mpc-icon-wrap img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }
  .mpc-step {
    font-size: 11px;
    font-weight: 800;
    color: #0284c7;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .mpc-title {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 8px;
  }
  .mpc-desc {
    font-size: 14px;
    color: #475569;
    line-height: 1.55;
    margin-bottom: 0;
  }

  /* Maida Nutritional Facts Table Styling */
  .maida-nutrition-box {
    background: #ffffff;
    border: 2px solid #0369a1;
    border-radius: 28px;
    padding: 2.5em;
    box-shadow: 0 20px 50px rgba(3, 105, 161, 0.1);
  }
  .maida-nutrition-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  .maida-nutrition-table th {
    background: #0369a1;
    color: #ffffff;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 700;
    text-align: left;
  }
  .maida-nutrition-table th:first-child {
    border-top-left-radius: 12px;
  }
  .maida-nutrition-table th:last-child {
    border-top-right-radius: 12px;
  }
  .maida-nutrition-table td {
    padding: 12px 16px;
    font-size: 14px;
    color: #334155;
    border-bottom: 1px solid #f1f5f9;
  }
  .maida-nutrition-table tr:nth-child(even) td {
    background: #f8fafc;
  }
  .mnutri-highlight {
    font-weight: 800;
    color: #0369a1;
  }
  .maida-fssai-strip {
    background: #e0f2fe;
    border-radius: 16px;
    padding: 14px 20px;
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .mffs-item {
    font-size: 13px;
    color: #0369a1;
  }
  .mffs-item strong {
    color: #0f172a;
  }
</style>

<section class="maida-spec-sec sec">
  <div class="container">

    <!-- 4 Key Badges Strip -->
    <div class="maida-badge-strip" data-aos="fade-down" data-aos-duration="900">
      <div class="mb-badge-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Soft Dough Results</span>
      </div>
      <div class="mb-badge-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>No Added Preservatives</span>
      </div>
      <div class="mb-badge-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Super Fine Grind</span>
      </div>
      <div class="mb-badge-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Perfect for Baking</span>
      </div>
    </div>

    <!-- Section Heading -->
    <div class="row text-center mb-5">
      <div class="col-lg-8 col-12 mx-auto">
        <span class="sub-pill mb-2" style="background: #e0f2fe; color: #0284c7;">Refined Wheat Flour Process</span>
        <h2 class="sec-head d-inline-block with-gr">Precision Roller Milling & Conditioning</h2>
        <p class="para mt-2">
          Every pack of Sunlit Farms Maida is roller-milled and finely sifted to deliver smooth dough formation, elasticity, and perfect bakery results.
        </p>
      </div>
    </div>

    <!-- Process Pillars (with solid defaults and Theme Editor icon upload option) -->
    <div class="row g-4 mb-5">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="col-lg-3 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="{{ forloop.index0 | times: 100 }}" {{ block.shopify_attributes }}>
            <div class="maida-process-card">
              
              <div class="mpc-icon-wrap">
                {% if block.settings.icon %}
                  <img src="{{ block.settings.icon | image_url: width: 120 }}" alt="{{ block.settings.title | escape }}">
                {% elsif forloop.index == 1 %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                {% elsif forloop.index == 2 %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M6 12h12"/></svg>
                {% elsif forloop.index == 3 %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/></svg>
                {% else %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endif %}
              </div>

              {% if block.settings.step != blank %}
                <span class="mpc-step">{{ block.settings.step }}</span>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="mpc-title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="mpc-desc">{{ block.settings.text }}</p>
              {% endif %}

            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- DEFAULT 4 MAIDA PROCESS CARDS -->
        <div class="col-lg-3 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000">
          <div class="maida-process-card">
            <div class="mpc-icon-wrap">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <span class="mpc-step">Step 01</span>
            <h3 class="mpc-title">Cleaning & Conditioning</h3>
            <p class="mpc-desc">Wheat grains cleaned & conditioned with moisture for smooth milling.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          <div class="maida-process-card">
            <div class="mpc-icon-wrap">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M6 12h12"/></svg>
            </div>
            <span class="mpc-step">Step 02</span>
            <h3 class="mpc-title">Roller Milling</h3>
            <p class="mpc-desc">Conditioned wheat roller milled separating bran germ & endosperm.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
          <div class="maida-process-card">
            <div class="mpc-icon-wrap">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/></svg>
            </div>
            <span class="mpc-step">Step 03</span>
            <h3 class="mpc-title">Sifting & Grading</h3>
            <p class="mpc-desc">Endosperm finely milled and sifted to produce refined maida.</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
          <div class="maida-process-card">
            <div class="mpc-icon-wrap">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span class="mpc-step">Step 04</span>
            <h3 class="mpc-title">Drying & Packaging</h3>
            <p class="mpc-desc">Maida quality checked & hygienically packed to retain freshness.</p>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Nutritional Facts & FSSAI Licenses -->
    <div class="row align-items-center g-5 mt-4" data-aos="fade-up" data-aos-duration="1000">
      
      <div class="col-lg-7 col-12">
        <div class="maida-nutrition-box">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <span class="sub-pill bg-light text-dark mb-1">Authentic Packaging Spec</span>
              <h3 class="fw-bold mb-0" style="color: #0369a1;">Nutritional Facts</h3>
            </div>
            <span class="badge bg-info text-white px-3 py-2 fs-6 fw-bold">Serving Size: 100g (Pack: 30g)</span>
          </div>

          <table class="maida-nutrition-table">
            <thead>
              <tr>
                <th>Nutrient Parameter</th>
                <th>Per 100g</th>
                <th>Per Serve (30g)</th>
                <th>% RDA</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="mnutri-highlight">Energy (Kcal)</td>
                <td>350.43</td>
                <td>105.13</td>
                <td>5.26%</td>
              </tr>
              <tr>
                <td class="mnutri-highlight">Protein (g)</td>
                <td>12.23</td>
                <td>3.67</td>
                <td>7.34%</td>
              </tr>
              <tr>
                <td class="mnutri-highlight">Carbohydrate (g)</td>
                <td>72.88</td>
                <td>21.86</td>
                <td>7.29%</td>
              </tr>
              <tr>
                <td>Total Sugar (g)</td>
                <td>0.00</td>
                <td>0.00</td>
                <td>0%</td>
              </tr>
              <tr>
                <td>Total Fat (g)</td>
                <td>1.11</td>
                <td>0.33</td>
                <td>0.49%</td>
              </tr>
              <tr>
                <td>Saturated Fat (g)</td>
                <td>0.25</td>
                <td>0.08</td>
                <td>0.34%</td>
              </tr>
              <tr>
                <td>Trans Fat (g)</td>
                <td>0.00</td>
                <td>0.00</td>
                <td>0%</td>
              </tr>
              <tr>
                <td>Sodium (mg)</td>
                <td>4.29</td>
                <td>1.29</td>
                <td>0.06%</td>
              </tr>
            </tbody>
          </table>

          <div class="maida-fssai-strip">
            <div class="mffs-item">Ingredients: <strong>100% Whole Wheat</strong></div>
            <div class="mffs-item">Storage: <strong>Store in cool & dry airtight container</strong></div>
          </div>

        </div>
      </div>

      <!-- FSSAI & Unit Licenses Box -->
      <div class="col-lg-5 col-12">
        <div class="card border-0 shadow-lg p-4" style="border-radius: 28px; background: linear-gradient(135deg, #0369a1 0%, #0c4a6e 100%); text-color: #ffffff;">
          <span class="badge bg-info text-white d-inline-block w-auto me-auto mb-3 px-3 py-2">FSSAI Certified Milling</span>
          <h3 class="text-white fw-bold mb-3">Guaranteed Purity & Safety</h3>
          <p class="text-white-50 para mb-4">
            Our Refined Wheat Flour (Maida) is produced across ISO & FSSC 22000 certified processing plants.
          </p>

          <div class="p-3 bg-white bg-opacity-10 rounded-4 mb-3 border border-white border-opacity-15">
            <span class="text-info small d-block fw-bold mb-1" style="color: #7dd3fc !important;">Akshat Agro Milling Co. Pvt. Ltd. (Nimrani, MP)</span>
            <span class="text-white fs-6 font-monospace">FSSAI Lic. No. 11414890000281</span>
          </div>

          <div class="p-3 bg-white bg-opacity-10 rounded-4 mb-3 border border-white border-opacity-15">
            <span class="text-info small d-block fw-bold mb-1" style="color: #7dd3fc !important;">Akshat Roller Flour Mill Pvt. Ltd. (Chandauli, UP)</span>
            <span class="text-white fs-6 font-monospace">FSSAI Lic. No. 12720039000182</span>
          </div>

          <div class="p-3 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-15">
            <span class="text-info small d-block fw-bold mb-1" style="color: #7dd3fc !important;">Simran Food Pvt. Ltd. (Varanasi, UP)</span>
            <span class="text-white fs-6 font-monospace">FSSAI Lic. No. 12714038000965</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Maida Specifications",
  "tag": "section",
  "class": "maida-details-section",
  "settings": [],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom Icon Image (Upload your own icon)"
        },
        {
          "type": "text",
          "id": "step",
          "label": "Step Eyebrow",
          "default": "Step 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Cleaning & Conditioning"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Wheat grains cleaned & conditioned with moisture for smooth milling."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maida Specifications",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step": "Step 01",
            "title": "Cleaning & Conditioning",
            "text": "Wheat grains cleaned & conditioned with moisture for smooth milling."
          }
        },
        {
          "type": "step",
          "settings": {
            "step": "Step 02",
            "title": "Roller Milling",
            "text": "Conditioned wheat roller milled separating bran germ & endosperm."
          }
        },
        {
          "type": "step",
          "settings": {
            "step": "Step 03",
            "title": "Sifting & Grading",
            "text": "Endosperm finely milled and sifted to produce refined maida."
          }
        },
        {
          "type": "step",
          "settings": {
            "step": "Step 04",
            "title": "Drying & Packaging",
            "text": "Maida quality checked & hygienically packed to retain freshness."
          }
        }
      ]
    }
  ]
}
{% endschema %}
