<section class="test-sec" style="margin-bottom: 20px !important; padding-bottom: 0px !important;">

  {% if section.settings.top_bg %}
    <img 
      src="{{ section.settings.top_bg | image_url: width: 1920 }}" 
      class="w-100 test-green-bg" 
      alt="background"
    >
  {% endif %}

  <div class="test-slider-sec">
    <div class="sec pt-0">
      <div class="container">

        <div class="row">
          <div class="col-lg-10 col-12 mx-auto text-center">

            {% if section.settings.heading != blank %}
              <h2 class="sec-head white" style="margin-bottom: 28px !important;" data-aos="fade-up" data-aos-duration="1000">       
                {{ section.settings.heading }}
              </h2>
            {% endif %}

            {% if section.settings.text != blank %}
              <p class="para white big mb-0" style="font-size: 20px; line-height: 1.65; max-width: 820px; margin: 0 auto;" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="150">
                {{ section.settings.text }}
              </p>
            {% endif %}

          </div>
        </div>

      </div>
    </div>

    {% if section.settings.bottom_bg %}
      <img 
        src="{{ section.settings.bottom_bg | image_url: width: 1920 }}" 
        class="w-100 test-grass-bg" 
        alt="background"
      >
    {% endif %}
  </div>

</section>

{% schema %}
{
  "name": "Purpose Section",
  "tag": "section",
  "class": "purpose-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_bg",
      "label": "Top Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feeding Everyday Moments"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "From the first roti of the morning to the snacks shared with family, we're proud to play a small role in countless everyday meals."
    },
    {
      "type": "image_picker",
      "id": "bottom_bg",
      "label": "Bottom Background Image"
    }
  ],
  "presets": [
    {
      "name": "Purpose Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}