<section class="product-sec sec">
  <div class="container">
    
    <!-- Heading -->
    <div class="row">
      <div class="col-12">
        <div class="pr-head d-flex align-items-center justify-content-center flex-wrap" data-aos="fade-up" data-aos-duration="1000">
          
          {% if section.settings.heading != blank %}
            <h3 class="sec-head with-gr text-center">
              {{ section.settings.heading }}
            </h3>
          {% endif %}

        </div>
      </div>
    </div>

    <!-- Grid -->
    <div class="row">
      <div class="col-12">
        <div class="ar-grid" data-aos="fade-up" data-aos-duration="1000" >

          <!-- Custom Animated SVG Curved Arrows -->
          <svg class="custom-process-arrow ar-svg-1" viewBox="0 0 260 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M 10,85 Q 130,5 245,78" stroke="#f97316" stroke-width="3.5" stroke-dasharray="8 6" stroke-linecap="round" class="animated-dash-path"/>
            <polygon points="248,80 236,73 240,86" fill="#f97316"/>
          </svg>

          <svg class="custom-process-arrow ar-svg-2" viewBox="0 0 260 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M 10,15 Q 130,95 245,22" stroke="#f97316" stroke-width="3.5" stroke-dasharray="8 6" stroke-linecap="round" class="animated-dash-path"/>
            <polygon points="248,20 240,12 236,25" fill="#f97316"/>
          </svg>

          {% for block in section.blocks %}
            <div class="ar-wrap" {{ block.shopify_attributes }}>
              
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="para">
                  {{ block.settings.text }}
                </p>
              {% endif %}

            </div>
          {% endfor %}

        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Process Grid",
  "tag": "section",
  "class": "process-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Commitment to Hygiene"
    },
    {
      "type": "image_picker",
      "id": "arrow_1",
      "label": "Arrow Image 1"
    },
    {
      "type": "image_picker",
      "id": "arrow_2",
      "label": "Arrow Image 2"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wheat Selection"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Carefully sourced and quality-tested grains."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process Grid",
      "category": "Custom",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Wheat Selection",
            "text": "Carefully sourced and quality-tested grains."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Milling",
            "text": "Modern technology ensures fine grinding and nutrient retention."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Packaging",
            "text": "Secure, contamination-free packing for long-lasting freshness."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Distribution",
            "text": "Efficient logistics network delivering across multiple states."
          }
        }
      ]
    }
  ]
}
{% endschema %}