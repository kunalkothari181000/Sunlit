<div class="page-hero-banner infra-hero-banner" style="background: linear-gradient(135deg, rgba(24, 67, 51, 0.88) 0%, rgba(10, 36, 26, 0.92) 100%), url('{{ section.settings.bg_image | image_url: width: 1920 }}') center/cover no-repeat;">
  <div class="container">
    <div class="row text-center">
      <div class="col-lg-8 col-12 mx-auto">
        <span class="hero-tag-badge" data-aos="fade-down" data-aos-duration="1000">Advanced Manufacturing</span>
        <h1 class="hero-page-head text-white" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          World-Class Milling Infrastructure
        </h1>
        <p class="hero-page-subtext text-white-50" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
          Engineered for purity, consistency, and high-volume output powered by Swiss Bühler automation.
        </p>
      </div>
    </div>
  </div>
</div>

<section class="infra-sec sec">
  <div class="container">

    <!-- Stat Highlights -->
    <div class="row g-4 mb-5">
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800">
        <div class="infra-stat-box">
          <div class="s-glow"></div>
          <h2 class="stat-num">1,200 <span class="unit">MT</span></h2>
          <p class="stat-label">Daily Sourcing & Milling</p>
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="100">
        <div class="infra-stat-box">
          <div class="s-glow"></div>
          <h2 class="stat-num">500k+ <span class="unit">Sq Ft</span></h2>
          <p class="stat-label">Integrated Facilities</p>
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="200">
        <div class="infra-stat-box">
          <div class="s-glow"></div>
          <h2 class="stat-num">Bühler</h2>
          <p class="stat-label">Automated Swiss Technology</p>
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="800" data-aos-delay="300">
        <div class="infra-stat-box">
          <div class="s-glow"></div>
          <h2 class="stat-num">100%</h2>
          <p class="stat-label">Touch-Free Hygienic Packing</p>
        </div>
      </div>
    </div>

    <!-- Section Heading (Centered Stack) -->
    <div class="row text-center mb-5">
      <div class="col-12">
        <div class="d-block mb-2" data-aos="fade-down" data-aos-duration="800">
          <span class="sub-pill">Our Units</span>
        </div>
        <h2 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
          Manufacturing & Milling Hubs
        </h2>
      </div>
    </div>

    <!-- 3 Plant Cards Grid with High Visual Elegance -->
    <div class="row g-4 mb-5">
      
      <!-- Unit 1 -->
      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000">
        <div class="plant-hero-card">
          <div class="plant-img-wrap">
            <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800" alt="AAM Milling Plant" class="plant-img">
            <span class="p-location-tag">Madhya Pradesh</span>
          </div>
          <div class="plant-card-body">
            <h3 class="plant-title">AAM - Akshat Agro Milling Co. Pvt. Ltd.</h3>
            <p class="plant-addr-text">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              1 to 8 & 23 to 33, AKVN Food Park, VILL - Nimrani, Dist - Khargone. 451001, MP
            </p>
            <div class="fssai-pill-badge">
              <span>FSSAI Lic. No.</span>
              <strong>11414890000281</strong>
            </div>
            <div class="p-tags-row">
              <span class="p-mini-tag">Grain Silos</span>
              <span class="p-mini-tag">Optical Sorting</span>
              <span class="p-mini-tag">Bühler Milling</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Unit 2 -->
      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="150">
        <div class="plant-hero-card">
          <div class="plant-img-wrap">
            <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=800" alt="ARF Milling Plant" class="plant-img">
            <span class="p-location-tag">Uttar Pradesh</span>
          </div>
          <div class="plant-card-body">
            <h3 class="plant-title">ARF - Akshat Roller Flour Mill Pvt. Ltd.</h3>
            <p class="plant-addr-text">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              A-4(A), Industrial Area, Ramnagar, Chandauli. 221110, Uttar Pradesh
            </p>
            <div class="fssai-pill-badge">
              <span>FSSAI Lic. No.</span>
              <strong>12720039000182</strong>
            </div>
            <div class="p-tags-row">
              <span class="p-mini-tag">Roller Flour Mill</span>
              <span class="p-mini-tag">Zero Touch Packing</span>
              <span class="p-mini-tag">Destoning</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Unit 3 -->
      <div class="col-lg-4 col-md-12 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
        <div class="plant-hero-card">
          <div class="plant-img-wrap">
            <img src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=800" alt="Simran Food Plant" class="plant-img">
            <span class="p-location-tag">Varanasi, UP</span>
          </div>
          <div class="plant-card-body">
            <h3 class="plant-title">Simran Food Pvt. Ltd.</h3>
            <p class="plant-addr-text">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              P 101/1, Vill - Sujabad, Parao, Varanasi. 221001, Uttar Pradesh
            </p>
            <div class="fssai-pill-badge">
              <span>Processing Center</span>
              <strong>Hygienic Hub</strong>
            </div>
            <div class="p-tags-row">
              <span class="p-mini-tag">Quality Lab</span>
              <span class="p-mini-tag">Bulk Dispatch</span>
              <span class="p-mini-tag">Airtight Packing</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Visual Process Grid Section -->
    <div class="row align-items-center g-4 my-5">
      <div class="col-lg-6 col-12" data-aos="fade-right" data-aos-duration="1000">
        <div class="visual-process-card">
          <div class="d-block mb-2">
            <span class="sub-pill">Tech Specs</span>
          </div>
          <h2 class="sec-head">Precision Milling Technology</h2>
          
          <div class="v-feature-item">
            <div class="vf-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h4>Optical Sorter & Magnetic Separator</h4>
              <p class="para">Eliminates foreign particles, unpolished grains, and dust before milling.</p>
            </div>
          </div>

          <div class="v-feature-item">
            <div class="vf-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <h4>Nutrient-Preserving Milling</h4>
              <p class="para">Temperature-controlled rollers safeguard natural wheat bran, dietary fiber, and germ.</p>
            </div>
          </div>

          <div class="v-feature-item">
            <div class="vf-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <div>
              <h4>Robotic Touch-Free Packing</h4>
              <p class="para">Fully automated bagging protects against humidity, insects, and atmospheric exposure.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-left" data-aos-duration="1000">
        <div class="infra-hero-preview-wrap">
          <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800" alt="Factory Operations" class="i-preview-img">
          <div class="i-floating-badge">
            <span class="fb-title">Bühler Certified</span>
            <span class="fb-text">Automated Grain Processing</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Infrastructure Page",
  "tag": "section",
  "class": "infrastructure-page-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero Background Image"
    }
  ],
  "presets": [
    {
      "name": "Infrastructure Page"
    }
  ]
}
{% endschema %}
