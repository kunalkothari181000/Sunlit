<section class="infra-sec sec">
  <div class="container">
    
    <!-- Hero Title -->
    <div class="row text-center mb-5">
      <div class="col-lg-8 col-12 mx-auto">
        <h1 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
          {{ section.settings.heading | default: "World-Class Milling Infrastructure" }}
        </h1>
        <p class="para mt-3" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
          {{ section.settings.subtext | default: "Powered by advanced Bühler milling technology, automated packaging lines, and multi-tier quality control laboratories across India." }}
        </p>
      </div>
    </div>

    <!-- Infrastructure Key Highlights -->
    <div class="row g-4 mb-5">
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000">
        <div class="infra-stat-card">
          <h2>1,200 MT</h2>
          <p class="para">Daily Sourcing & Milling Capacity</p>
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
        <div class="infra-stat-card">
          <h2>500k+</h2>
          <p class="para">Sq. Ft. Integrated Facilities</p>
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
        <div class="infra-stat-card">
          <h2>Bühler</h2>
          <p class="para">Swiss Automated Milling Lines</p>
        </div>
      </div>
      <div class="col-lg-3 col-sm-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
        <div class="infra-stat-card">
          <h2>100%</h2>
          <p class="para">Touch-Free Hygienic Packing</p>
        </div>
      </div>
    </div>

    <!-- Factory & Milling Units Grid -->
    <div class="row text-center mb-4">
      <div class="col-12">
        <h2 class="sec-head with-gr d-inline-block" data-aos="fade-up" data-aos-duration="1000">
          Our Manufacturing & Milling Plants
        </h2>
      </div>
    </div>

    <div class="row g-4 mb-5">
      
      <!-- Unit 1 -->
      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000">
        <div class="plant-card">
          <div class="plant-header">
            <span class="p-badge">Madhya Pradesh Plant</span>
            <h3>AAM - Akshat Agro Milling Company Pvt. Ltd.</h3>
          </div>
          <div class="plant-body">
            <p class="p-addr">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              1 to 8 and 23 to 33, AKVN Food Park, VILL - Nimrani, Dist - Khargone. 451001, Madhya Pradesh
            </p>
            <div class="fssai-box mt-3">
              <span class="fssai-label">FSSAI Lic. No.</span>
              <span class="fssai-num">11414890000281</span>
            </div>
            <ul class="plant-features">
              <li>High-Capacity Grain Storage Silos</li>
              <li>Precision Grinding & Sifting Systems</li>
              <li>Automated Moisture Monitoring</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Unit 2 -->
      <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="150">
        <div class="plant-card">
          <div class="plant-header">
            <span class="p-badge">Uttar Pradesh Plant 1</span>
            <h3>ARF - Akshat Roller Flour Mill Pvt. Ltd.</h3>
          </div>
          <div class="plant-body">
            <p class="p-addr">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              A-4(A), Industrial Area, Ramnagar, Chandauli. 221110, Uttar Pradesh
            </p>
            <div class="fssai-box mt-3">
              <span class="fssai-label">FSSAI Lic. No.</span>
              <span class="fssai-num">12720039000182</span>
            </div>
            <ul class="plant-features">
              <li>Advanced Roller Flour Technology</li>
              <li>Zero-Hand-Touch Hygienic Lines</li>
              <li>Multi-Stage Contamination Filters</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Unit 3 -->
      <div class="col-lg-4 col-md-12 col-12" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
        <div class="plant-card">
          <div class="plant-header">
            <span class="p-badge">Uttar Pradesh Plant 2</span>
            <h3>Simran Food Pvt. Ltd.</h3>
          </div>
          <div class="plant-body">
            <p class="p-addr">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              P 101/1, Vill - Sujabad, Parao, Varanasi. 221001, Uttar Pradesh
            </p>
            <div class="fssai-box mt-3">
              <span class="fssai-label">Processing Center</span>
              <span class="fssai-num">Hygienic Processing</span>
            </div>
            <ul class="plant-features">
              <li>Quality Testing Laboratory</li>
              <li>Bulk Distribution & Logistics Hub</li>
              <li>Airtight Sealed Packaging</li>
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Processing Capabilities Section -->
    <div class="row align-items-center g-4 mt-4">
      <div class="col-lg-6 col-12" data-aos="fade-right" data-aos-duration="1000">
        <div class="infra-content-box">
          <h2 class="sec-head">End-to-End Quality Engineering</h2>
          <p class="para mb-4">
            Our facilities are engineered to deliver consistent quality across Chakki Atta, Maida, Sooji, Rawa, and Dalia. From raw grain selection to final dispatch, every step operates under strict international hygiene and safety standards.
          </p>
          <div class="infra-feature-list">
            <div class="if-item">
              <span class="if-num">01</span>
              <div>
                <h4>Automated Cleaning & Destoning</h4>
                <p class="para">Grains undergo multi-stage magnetic separation and optical sorting to remove impurities.</p>
              </div>
            </div>
            <div class="if-item">
              <span class="if-num">02</span>
              <div>
                <h4>Controlled Temperature Milling</h4>
                <p class="para">Grinding temperature is strictly monitored to preserve natural nutrients, dietary fiber, and flavor.</p>
              </div>
            </div>
            <div class="if-item">
              <span class="if-num">03</span>
              <div>
                <h4>Hermetic Barrier Packaging</h4>
                <p class="para">High-barrier packaging protects products from moisture, pests, and ambient contamination.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6 col-12" data-aos="fade-left" data-aos-duration="1000">
        <div class="infra-visual-card">
          <img src="{{ 'ss.png' | shopify_asset_url | default: 'https://cdn.shopify.com/s/files/1/0000/0000/files/hero.png' }}" alt="Milling Infrastructure" class="img-fluid rounded-4 shadow-lg w-100">
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Infrastructure Page",
  "tag": "section",
  "class": "infra-page-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "World-Class Milling Infrastructure"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Powered by advanced Bühler milling technology, automated packaging lines, and multi-tier quality control laboratories across India."
    }
  ],
  "presets": [
    {
      "name": "Infrastructure Page"
    }
  ]
}
{% endschema %}
