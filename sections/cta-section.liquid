<section class="cta-sec sec">
  <div class="container">
    <div class="cta-wrap " data-aos="fade-up" data-aos-duration="1000">

      {% if section.settings.bg_image %}
        <img 
          src="{{ section.settings.bg_image | image_url: width: 1920 }}" 
          alt="background"
        >
      {% endif %}

      <div class="row justify-content-center">
        <div class="col-lg-6 col-12">

          {% if section.settings.heading != blank %}
            <h3 class="sec-head">
              {{ section.settings.heading }}
            </h3>
          {% endif %}

          {% if section.settings.subtext != blank %}
            <p class="para">
              {{ section.settings.subtext }}
            </p>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link }}" class="main-btn orange-btn center">
              
              <span>{{ section.settings.button_label }}</span>

              {% if section.settings.button_icon %}
                <img 
                  src="{{ section.settings.button_icon | image_url: width: 50 }}" 
                  alt="icon"
                >
              {% endif %}

            </a>
          {% endif %}

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Section",
  "tag": "section",
  "class": "cta-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partner with a Trusted Brand"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Available Across Your Region"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "Button Icon"
    }
  ],
  "presets": [
    {
      "name": "CTA Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}